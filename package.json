{
  "name": "andrew-dental-system",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent dental customer and administrator workflow",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "node tools/build.mjs",
    "build:styles": "node tools/build-styles.mjs",
    "build:docs": "node tools/build-docs.mjs",
    "check": "node tools/check-source.mjs",
    "test": "node --test test/*.test.js",
    "test:maintenance": "node tools/verify-maintenance.mjs",
    "test:browser": "node tools/run-e2e.mjs",
    "test:load": "node tools/load-test.mjs",
    "release:manifest": "node tools/release-manifest.mjs",
    "dev:api": "npm run dev -w @andrew/booking-api",
    "dev:admin": "npm run dev -w @andrew/admin-web",
    "build:booking": "npm run build -w @andrew/booking-api && npm run build -w @andrew/admin-web && npm run build -w @andrew/miniprogram",
    "check:booking": "npm run typecheck --workspaces --if-present",
    "test:booking": "npm run test -w @andrew/booking-api",
    "db:migrate": "npm run migrate -w @andrew/booking-api",
    "db:seed": "npm run seed -w @andrew/booking-api",
    "dev:postgres": "node scripts/local-postgres.mjs",
    "check:deploy": "node scripts/validate-compose.mjs",
    "test:booking-browser": "node scripts/booking-browser.mjs",
    "test:mini-api": "npm run build -w @andrew/miniprogram && node miniprogram/scripts/native-api-smoke.mjs",
    "test:persistence:before": "node scripts/verify-persistence.mjs before",
    "test:persistence:after": "node scripts/verify-persistence.mjs after",
    "admin:create": "npm run admin:create -w @andrew/booking-api"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "cssnano": "^9.8.0",
    "embedded-postgres": "17.10.0-beta.17",
    "postcss": "^8.5.30",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "yaml": "^2.9.1"
  },
  "workspaces": [
    "shared",
    "booking-api",
    "admin-web",
    "miniprogram"
  ]
}
