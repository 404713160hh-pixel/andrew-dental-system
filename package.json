{
  "name": "andrew-dental-system",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "description": "Andrew Dental website, staff workspace, and WeChat mini program",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w @andrew/booking-api",
    "dev:admin": "npm run dev -w @andrew/admin-web",
    "build:booking": "npm run build -w @andrew/booking-api && npm run build -w @andrew/admin-web && npm run build -w @andrew/miniprogram",
    "check:booking": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run migrate -w @andrew/booking-api",
    "db:seed": "npm run seed -w @andrew/booking-api",
    "db:demo": "npm run demo -w @andrew/booking-api",
    "db:demo:scenarios": "npm run demo:scenarios -w @andrew/booking-api",
    "dev:postgres": "node scripts/local-postgres.mjs",
    "sync:wechat": "node scripts/sync-wechat-project.mjs",
    "admin:create": "npm run admin:create -w @andrew/booking-api"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "embedded-postgres": "17.10.0-beta.17",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "workspaces": [
    "shared",
    "booking-api",
    "admin-web",
    "miniprogram"
  ]
}
