# Local native PostgreSQL; npm run dev:postgres generates a private working file.
NODE_ENV=development
DATABASE_URL=postgresql://andrew:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/andrew_booking_dev
BOOKING_HOST=127.0.0.1
BOOKING_PORT=3310
ALLOW_DEMO_LOGIN=false
SEED_PASSWORD=REPLACE_WITH_RANDOM_12_OR_MORE_CHARACTERS
HOLD_SECONDS=300
CANCELLATION_NOTICE_MINUTES=120
TRANSFER_BUFFER_MINUTES=30
SLOT_STEP_MINUTES=15
SESSION_HOURS=12
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
