# 部署配置模板：复制后调整域名、目录和监听方式。
# npm start 不自动读取环境文件；可由服务环境注入，
# 或在 Node 24 中显式运行 node --env-file=.env.local server/index.js。
HOST=127.0.0.1
PORT=3210
DENTAL_DB_PATH=./server/data/dental.sqlite
PUBLIC_ORIGIN=https://dental.example.com
COOKIE_SECURE=1

# 0：空业务库，不创建演示账号/数据，不显示演示体验按钮。
# 正式初始化首个店长使用 tools/accounts.mjs，密码从临时环境变量输入。
# 本机演示可以设为1；HTTP演示需要同时把COOKIE_SECURE改为0，调整PUBLIC_ORIGIN。
DENTAL_SEED_DEMO=0
