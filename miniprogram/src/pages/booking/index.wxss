ight:650;margin-bottom:10rpx}.result-heading{margin-top:34rpx}.result-heading .section-title{margin-bottom:8rpx}.slot-period{margin-bottom:30rpx}.period-heading{display:flex;align-items:center;justify-content:space-between;padding:10rpx 2rpx 16rpx;color:#64748b;font-size:22rpx}.period-title{display:flex;align-items:center;gap:12rpx;color:#111827;font-size:28rpx;font-weight:600}.period-dot{width:13rpx;height:13rpx;border-radius:50%;background:#2563eb}.slot-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.slot-card{padding:26rpx 22rpx;margin-bottom:0;border-color:#e5eaf2;border-radius:14rpx;min-width:0}.slot-time{font-weight:600;font-size:32rpx;line-height:1.6;white-space:normal}.slot-time text{font-weight:400;font-size:22rpx;color:#64748b}.slot-price{color:#1d4ed8;font-size:23rpx;line-height:1.7;margin:16rpx 0 20rpx}.slot-card .secondary{padding:14rpx;font-size:25rpx}.empty-calendar{position:relative;box-sizing:border-box;width:150rpx;height:140rpx;margin:10rpx auto;background:#f8fafc;border:3rpx solid #e5eaf2;color:#2563eb}.empty-calendar view{height:30rpx;border-bottom:3rpx solid #e5eaf2}.empty-calendar text{display:block;text-align:center;font-size:58rpx;line-height:96rpx}.empty-help{text-align:center;font-size:24rpx;line-height:1.9;color:#64748b;padding:0 22rpx}@media(max-width:350px){.quick-date{min-width:61rpx}.quick-date-list{gap:8rpx}.filter-heading{align-items:flex-start}.filter-heading .small{font-size:19rpx}.slot-time{font-size:30rpx}}

.booking-page>.title{font-size:38rpx;line-height:1.45;margin-bottom:14rpx}.booking-page .two-columns>view{min-width:0}.booking-page .picker{font-size:25rpx;line-height:1.6;padding:18rpx;white-space:normal;word-break:break-word}.booking-page .doctor-info{line-height:1.85}.booking-page .slot-card>.muted{font-size:23rpx;line-height:1.8;word-break:break-word}.booking-page .result-heading{align-items:flex-start;flex-wrap:wrap;gap:12rpx}

/* Visual grouping follows the existing selection and search flow. */
.booking-page .booking-steps{background:#fff;border:1rpx solid #e5eaf2;border-radius:20rpx;padding:24rpx 16rpx;margin-bottom:30rpx}
.booking-page .booking-filter{border-color:#e5eaf2;border-radius:22rpx;box-shadow:0 8rpx 28rpx rgba(37,99,235,.05)}
.booking-page .booking-kicker{font-size:21rpx;font-weight:600;color:#2563eb;letter-spacing:1rpx;margin-bottom:6rpx}
.booking-page .filter-subheading{border-top:1rpx solid #e5eaf2;margin-top:32rpx;padding-top:28rpx}
.booking-page .filter-subheading .section-title{font-size:29rpx;margin:0}
.booking-page .two-columns .label{margin-top:18rpx}
.booking-page .service-summary{border-left-color:#2563eb;border-radius:0 12rpx 12rpx}
.booking-page .quick-date{border-radius:12rpx;background:#f8fafc}
.booking-page .quick-date-selected{background:#2563eb;color:#fff;border-color:#2563eb}
.booking-page .quick-date-selected .quick-date-month{color:#fff}
.booking-page .result-heading{margin-bottom:8rpx}
.booking-page .slot-card{border-color:#e5eaf2;box-shadow:0 6rpx 20rpx rgba(37,99,235,.04)}
.booking-page .slot-card .secondary{width:100%}

/* Five actual stages; only reached stages are highlighted. */
.journey-progress{display:flex;justify-content:space-between;gap:4rpx;background:#fff;border:1rpx solid #e5eaf2;border-radius:20rpx;padding:20rpx 12rpx 18rpx;margin-bottom:28rpx}
.journey-item{flex:1;min-width:0;text-align:center;font-size:20rpx;line-height:1.35;color:#64748b;white-space:nowrap}
.journey-number{width:38rpx;height:38rpx;line-height:38rpx;margin:0 auto 8rpx;border-radius:50%;background:#f8fafc;color:#64748b;font-size:21rpx;font-weight:600}
.journey-item.passed .journey-number{background:#e8f1ff;color:#1d4ed8}
.journey-item.current{color:#1d4ed8;font-weight:600}
.journey-item.current .journey-number{background:#2563eb;color:#fff}
@media(max-width:350px){.journey-progress{padding-left:4rpx;padding-right:4rpx}.journey-item{font-size:18rpx}}

.booking-page .selection-summary{background:#eff6ff;color:#1d4ed8;border-radius:12rpx;padding:16rpx 20rpx;margin-bottom:26rpx;font-size:23rpx;line-height:1.6;word-break:break-word}
.booking-page .step-section .section-title{font-size:30rpx;margin:4rpx 0 0}
.booking-page .step-controls{display:flex;gap:14rpx;margin-top:30rpx}
.booking-page .step-controls button{min-width:0;margin:0}
.booking-page .step-back{flex:0 0 27%}
.booking-page .step-next,.booking-page .search-slots-button{flex:1}
.booking-page .slot-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}
.booking-page .slot-option{width:100%;min-width:0;margin:0;padding:18rpx 16rpx;text-align:left;line-height:1.45;background:#fff;border:1rpx solid #e5eaf2;border-radius:14rpx;color:#111827;white-space:normal}
.booking-page .slot-option::after{border:0}
.booking-page .slot-option .slot-time{font-size:28rpx;line-height:1.4}
.booking-page .slot-option .slot-time text{font-size:20rpx;color:#64748b}
.booking-page .slot-meta{font-size:21rpx;color:#64748b;margin-top:6rpx;word-break:break-word}
.booking-page .slot-option .slot-price{font-size:21rpx;margin:6rpx 0;color:#1d4ed8}
.booking-page .slot-action{font-size:21rpx;font-weight:600;color:#2563eb;margin-top:6rpx}
.booking-page .slot-option[disabled] .slot-action,.booking-page .slot-option[disabled] .slot-price{color:#64748b}
