.intro{margin-bottom:28rpx}.service-summary{background:#f1f8f8;border-radius:16rpx;padding:22rpx;margin-top:18rpx;font-size:24rpx;color:#4c7c84}.service-summary .space{margin-top:12rpx}.doctor-info{margin-top:22rpx;padding-top:15rpx;border-top:1rpx solid #e7eff1}.doctor-info .section-title{font-size:28rpx}.doctor-info .small{color:#578591;margin-top:8rpx}.slot-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.slot-card{padding:25rpx 20rpx;margin-bottom:0}.slot-time{font-weight:700;font-size:34rpx;white-space:nowrap}.slot-time text{font-weight:400;font-size:22rpx;color:#8298a3}.slot-price{color:#187c85;font-size:24rpx;margin:15rpx 0}.slot-card .secondary{padding:14rpx;font-size:25rpx}
.booking-steps{padding:0 0 18rpx;background:transparent}.filter-heading{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.filter-heading .section-title{font-size:29rpx;margin:0}.filter-heading .small{font-size:21rpx}.date-heading{display:flex;align-items:center;justify-content:space-between;margin-top:10rpx}.date-heading .label{margin:20rpx 0 14rpx}.calendar-button{display:flex;align-items:center;gap:10rpx;background:transparent;color:#0b858d;font-size:23rpx;line-height:1.5;padding:10rpx 0 10rpx 12rpx;margin:0;border-radius:10rpx}.calendar-button::after{border:0}.calendar-button text{font-size:30rpx}.quick-date-scroll{width:100%;white-space:nowrap}.quick-date-list{display:flex;gap:10rpx;padding:2rpx 0 8rpx}.quick-date{flex:1;min-width:67rpx;text-align:center;padding:14rpx 3rpx 10rpx;background:#f5f8f9;border:1rpx solid #e7eff1;border-radius:16rpx;color:#718591;transition:background .15s,color .15s}.quick-date text{display:block;font-size:20rpx}.quick-date view{font-size:31rpx;line-height:1.4;font-weight:650;margin:6rpx 0 3rpx}.quick-date .quick-date-month{font-size:18rpx;color:#92a2ab}.quick-date-selected{background:#0b858d;color:#fff;border-color:#0b858d;box-shadow:0 5rpx 14rpx rgba(11,133,141,.16)}.quick-date-selected .quick-date-month{color:#c0e1e0}.quick-date-disabled{opacity:.55}.date-help{font-size:21rpx;color:#899da7;line-height:1.8;margin-top:10rpx}.booking-loading{padding:35rpx 0 42rpx}.feedback-title{font-weight:650;margin-bottom:10rpx}.result-heading{margin-top:34rpx}.result-heading .section-title{margin-bottom:8rpx}.slot-period{margin-bottom:30rpx}.period-heading{display:flex;align-items:center;justify-content:space-between;padding:10rpx 2rpx 16rpx;color:#8b9ea8;font-size:22rpx}.period-title{display:flex;align-items:center;gap:12rpx;color:#385864;font-size:28rpx;font-weight:650}.period-dot{width:13rpx;height:13rpx;border-radius:50%;background:#d3b47a}.period-dot.afternoon{background:#4ba49c}.period-dot.evening{background:#829fc3}.empty-calendar{position:relative;box-sizing:border-box;width:150rpx;height:140rpx;margin:10rpx auto;background:#edf5f6;border:3rpx solid #d0e3e6;border-radius:22rpx;color:#aac9cf}.empty-calendar view{height:30rpx;border-bottom:3rpx solid #d0e3e6}.empty-calendar text{display:block;text-align:center;font-size:58rpx;line-height:96rpx}.empty-help{text-align:center;font-size:24rpx;line-height:1.9;color:#8b9da6;padding:0 22rpx}@media(max-width:350px){.quick-date{min-width:61rpx}.quick-date-list{gap:8rpx}.filter-heading{align-items:flex-start}.filter-heading .small{font-size:19rpx}.slot-time{font-size:30rpx}}
