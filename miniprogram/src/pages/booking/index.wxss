ight:650;margin-bottom:10rpx}.result-heading{margin-top:34rpx}.result-heading .section-title{margin-bottom:8rpx}.slot-period{margin-bottom:30rpx}.period-heading{display:flex;align-items:center;justify-content:space-between;padding:10rpx 2rpx 16rpx;color:#77746f;font-size:22rpx}.period-title{display:flex;align-items:center;gap:12rpx;color:#252522;font-size:28rpx;font-weight:600}.period-dot{width:13rpx;height:13rpx;border-radius:50%;background:#b79a6b}.slot-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.slot-card{padding:26rpx 22rpx;margin-bottom:0;border-color:#eae7e1;border-radius:14rpx;min-width:0}.slot-time{font-weight:600;font-size:32rpx;line-height:1.6;white-space:normal}.slot-time text{font-weight:400;font-size:22rpx;color:#77746f}.slot-price{color:#826a48;font-size:23rpx;line-height:1.7;margin:16rpx 0 20rpx}.slot-card .secondary{padding:14rpx;font-size:25rpx}.empty-calendar{position:relative;box-sizing:border-box;width:150rpx;height:140rpx;margin:10rpx auto;background:#fcfbf9;border:3rpx solid #eae7e1;color:#b79a6b}.empty-calendar view{height:30rpx;border-bottom:3rpx solid #eae7e1}.empty-calendar text{display:block;text-align:center;font-size:58rpx;line-height:96rpx}.empty-help{text-align:center;font-size:24rpx;line-height:1.9;color:#77746f;padding:0 22rpx}@media(max-width:350px){.quick-date{min-width:61rpx}.quick-date-list{gap:8rpx}.filter-heading{align-items:flex-start}.filter-heading .small{font-size:19rpx}.slot-time{font-size:30rpx}}

