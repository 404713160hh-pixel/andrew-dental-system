<view class="page booking-page">
  <van-steps custom-class="booking-steps" steps="{{steps}}" active="{{0}}" active-color="#9e8257" inactive-color="#91a4ad" />
  <view class="title">{{oldAppointmentId ? '换一个合适的时间' : '选择你的就诊安排'}}</view><view class="muted intro">{{oldAppointmentId ? '选择新时段，确认后替换原预约。' : '选择时段后将短时保留，请及时确认。'}}</view>
  <view wx:if="{{pending}}" class="notice">有一笔预约操作结果待确认。<view class="link space" bindtap="pendingPage">去核对原操作 →</view></view>
  <view class="card booking-filter"><view class="filter-heading"><view class="section-title">安排本次就诊</view><text class="small muted">时间均为北京时间</text></view><text class="label">就诊门诊</text><picker range="{{clinics}}" range-key="name" value="{{clinicIndex}}" bindchange="clinicChange" disabled="{{loading || searching || holding || !clinics.length}}"><view class="picker">{{clinics[clinicIndex].name || (catalogFailed ? '门诊资料读取未完成' : '暂无开放门诊')}} ▾</view></picker>
    <text class="label">服务项目</text><picker range="{{services}}" range-key="name" value="{{serviceIndex}}" bindchange="serviceChange" disabled="{{loading || searching || holding || !services.length}}"><view class="picker">{{serviceUnavailable ? '请选择其他开放咨询服务' : services[serviceIndex].name || (catalogFailed ? '服务资料读取未完成' : '暂无可预约服务')}} ▾</view></picker>
    <view wx:if="{{services.length && !serviceUnavailable}}" class="service-summary"><view class="space">约 {{services[serviceIndex].durationMinutes}} 分钟</view><view>本次服务参考费 ¥{{services[serviceIndex].priceLabel}} / {{services[serviceIndex].unit}}</view><view class="fee-explanation">后续治疗及材料费用以面诊为准。</view></view>
    <view class="two-columns"><view><text class="label">就诊日期</text><picker mode="date" start="{{minDate}}" end="{{calendarEndDate}}" value="{{date}}" bindchange="dateChange" disabled="{{loading || searching || holding}}"><view class="picker">{{date}}</view></picker></view><view><text class="label">接诊医生</text><picker range="{{doctorNames}}" value="{{doctorIndex}}" bindchange="doctorChange" disabled="{{loading || searching || holding || catalogFailed}}"><view class="picker">{{doctorUnavailable ? '请重新选择匹配医生' : doctorNames[doctorIndex]}} ▾</view></picker></view></view>
    <view class="date-heading"><text class="label">未来七日快捷选择</text><button class="calendar-button" bindtap="openCalendar" disabled="{{loading || searching || holding || catalogFailed || !policy}}">打开日历 <text>▦</text></button></view>
    <scroll-view scroll-x class="quick-date-scroll"><view class="quick-date-list"><view wx:for="{{quickDates}}" wx:key="date" class="quick-date {{item.date === date ? 'quick-date-selected' : ''}} {{loading || searching || holding ? 'quick-date-disabled' : ''}}" hover-class="date-pressed" data-date="{{item.date}}" bindtap="quickDate"><text>{{item.label}}</text><view>{{item.number}}</view><text class="quick-date-month">{{item.month}}</text></view></view></scroll-view><view class="date-help">请选择日期并查询时段。</view>
    <view wx:if="{{doctorIndex > 0}}" class="doctor-info"><view class="demo-label-row"><view class="section-title">{{doctors[doctorIndex - 1].name}}</view><text wx:if="{{doctors[doctorIndex - 1].isDemo}}" class="demo-badge">虚构医生</text></view><view class="muted">{{doctors[doctorIndex - 1].specialty}}</view><view class="small" wx:for="{{doctors[doctorIndex - 1].qualificationRows}}" wx:key="id">{{item.name}} · {{item.validityLabel}}</view></view>
    <button class="primary space" bindtap="search" loading="{{searching || loading}}" disabled="{{loading || searching || holding || catalogFailed || !services.length || serviceUnavailable || doctorUnavailable}}">查询可预约时段</button>
  </view>
  <view wx:if="{{error}}" class="error"><view wx:if="{{catalogFailed}}" class="feedback-title">门诊与医生资料暂未读取完成</view>{{error}}<button wx:if="{{catalogFailed}}" class="secondary space" bindtap="retryLoad" disabled="{{loading || searching || holding}}">原地重试</button></view>
  <van-loading wx:if="{{loading}}" custom-class="booking-loading" color="#9e8257" size="24px" vertical>正在加载…</van-loading><van-loading wx:if="{{searching}}" custom-class="booking-loading" color="#9e8257" size="24px" vertical>正在查询…</van-loading>
  <van-empty wx:if="{{!loading && !catalogFailed && !error && !clinics.length}}" image="" description="暂未开放就诊门诊"><view slot="image" class="empty-calendar"><view></view><text>＋</text></view><view class="empty-help">请稍后查看，或联系门诊了解安排。</view></van-empty>
  <van-empty wx:if="{{!loading && !catalogFailed && !error && clinics.length && !services.length}}" image="" description="当前门诊暂未开放可预约服务"><view slot="image" class="empty-calendar"><view></view><text>＋</text></view><view class="empty-help">可切换门诊，或稍后重新查看。</view></van-empty>
  <block wx:if="{{queried && !error}}"><view wx:if="{{!signedIn}}" class="notice">登录后可预约。<view class="link space" bindtap="login">登录 / 注册 →</view></view><view class="row result-heading"><view class="section-title">{{date}} 的时段</view><text class="muted">{{slots.length}} 个可选</text></view><van-empty wx:if="{{!slots.length}}" image="" description="当天暂无匹配时段"><view slot="image" class="empty-calendar"><view></view><text>○</text></view><view class="empty-help">请更换日期、门诊或医生。</view><button class="secondary space" bindtap="openCalendar">换一天看看</button></van-empty>
    <view wx:for="{{slotGroups}}" wx:for-item="group" wx:key="key" class="slot-period"><view class="period-heading"><view class="period-title"><view class="period-dot {{group.key}}"></view>{{group.title}}</view><text>{{group.indices.length}} 个可选时段</text></view><view class="slot-grid"><view wx:for="{{group.indices}}" wx:for-item="slotIndex" wx:key="*this" class="card slot-card"><view class="slot-time">{{slots[slotIndex].startLabel}}<text>—{{slots[slotIndex].endLabel}}</text></view><view class="muted">{{slots[slotIndex].doctorName}} · {{slots[slotIndex].durationMinutes}} 分钟</view><text wx:if="{{slots[slotIndex].doctorIsDemo}}" class="demo-badge">虚构医生</text><view class="slot-price">本次参考费 ¥{{slots[slotIndex].priceLabel}}</view><button class="secondary" data-index="{{slotIndex}}" bindtap="choose" disabled="{{!signedIn || loading || searching || holding || pending}}" loading="{{holding}}">{{signedIn ? '选择时段' : '登录后预约'}}</button></view></view></view>
  </block><view class="footer-note">实际医疗方案与费用需由医务人员评估确认</view>
  <van-calendar show="{{calendarVisible}}" title="选择就诊日期" color="#9e8257" min-date="{{calendarMin}}" max-date="{{calendarMax}}" default-date="{{calendarDate}}" first-day-of-week="{{1}}" readonly="{{loading || searching || holding}}" confirm-text="选择这一天" bind:close="closeCalendar" bind:confirm="calendarConfirm" />
</view>
