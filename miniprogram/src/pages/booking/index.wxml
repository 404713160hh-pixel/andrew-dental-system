<view class="page">
  <view class="step"><text class="active">01 选择时段</text><text>—</text><text>02 核对确认</text><text>—</text><text>03 预约完成</text></view>
  <view class="title">{{oldAppointmentId ? '换一个合适的时间' : '选择你的就诊安排'}}</view><view class="muted intro">{{oldAppointmentId ? '原预约仍保留，请选择其他空闲时段；新安排确认成功后才会替换。' : '号源由服务器统一计算。查询只表示当前可用，不会占号。'}}</view>
  <view wx:if="{{pending}}" class="notice">有一笔预约操作结果待确认。<view class="link space" bindtap="pendingPage">去核对原操作 →</view></view>
  <view class="card"><text class="label">就诊门诊</text><picker range="{{clinics}}" range-key="name" value="{{clinicIndex}}" bindchange="clinicChange" disabled="{{loading || searching || holding}}"><view class="picker">{{clinics[clinicIndex].name || '暂无开放门诊'}} ▾</view></picker>
    <text class="label">服务项目</text><picker range="{{services}}" range-key="name" value="{{serviceIndex}}" bindchange="serviceChange" disabled="{{loading || searching || holding}}"><view class="picker">{{services[serviceIndex].name || '暂无可预约服务'}} ▾</view></picker>
    <view wx:if="{{services.length}}" class="service-summary"><text>{{services[serviceIndex].description}}</text><view class="space">就诊约 {{services[serviceIndex].durationMinutes}} 分钟 · 预留缓冲 {{services[serviceIndex].bufferMinutes}} 分钟</view><view>参考价格 ¥{{services[serviceIndex].priceLabel}} / {{services[serviceIndex].unit}}</view></view>
    <view class="two-columns"><view><text class="label">就诊日期</text><picker mode="date" start="{{minDate}}" value="{{date}}" bindchange="dateChange" disabled="{{loading || searching || holding}}"><view class="picker">{{date}}</view></picker></view><view><text class="label">接诊医生</text><picker range="{{doctorNames}}" value="{{doctorIndex}}" bindchange="doctorChange" disabled="{{loading || searching || holding}}"><view class="picker">{{doctorNames[doctorIndex]}} ▾</view></picker></view></view>
    <view wx:if="{{doctorIndex > 0}}" class="doctor-info"><view class="section-title">{{doctors[doctorIndex - 1].name}}</view><view class="muted">{{doctors[doctorIndex - 1].specialty}}</view><view class="small" wx:for="{{doctors[doctorIndex - 1].qualifications}}" wx:key="qualificationId">{{item.qualificationName || item.qualificationId}} · {{item.validUntil ? '有效至 ' + item.validUntil : '有效资格'}}</view></view>
    <button class="primary space" bindtap="search" loading="{{searching || loading}}" disabled="{{loading || searching || holding || !services.length}}">查询可预约时段</button>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{searching}}" class="loading">正在核对医生、牙椅与有效占位…</view>
  <block wx:if="{{queried}}"><view class="row"><view class="section-title">{{date}} 的时段</view><text class="muted">{{slots.length}} 个可选</text></view><view wx:if="{{!slots.length}}" class="empty">当天暂无匹配时段。<view class="space">请调整日期、门诊或医生后重新查询。</view></view>
    <view class="slot-grid"><view wx:for="{{slots}}" wx:key="key" class="card slot-card"><view class="slot-time">{{item.startLabel}}<text>—{{item.endLabel}}</text></view><view class="muted">{{item.doctorName}} · {{item.durationMinutes}} 分钟</view><view class="slot-price">参考费用 ¥{{item.priceLabel}}</view><button class="secondary" data-index="{{index}}" bindtap="choose" disabled="{{holding || pending}}" loading="{{holding}}">选择时段</button></view></view>
  </block><view class="footer-note">实际医疗方案与费用需由医务人员评估确认</view>
</view>
