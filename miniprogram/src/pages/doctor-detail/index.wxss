 .doctor-detail-page{padding-top:16rpx}.doctor-profile{background:#fcfbf9;border:1rpx solid #eae7e1;padding:32rpx 28rpx;text-align:center;margin-bottom:24rpx}.profile-portrait{position:relative;margin:0 auto 28rpx;width:220rpx;height:260rpx;overflow:hidden;background:#f7f5f1}.profile-portrait image{width:100%;height:100%;display:block}.profile-portrait text{position:absolute;right:8rpx;bottom:8rpx;color:#625b50;font-size:19rpx;background:#fff;padding:4rpx 8rpx}.doctor-profile>.eyebrow{font-size:18rpx;letter-spacing:3rpx}.profile-name{font-family:"Noto Serif SC","Songti SC",serif;font-size:42rpx;font-weight:600;line-height:1.5;margin:13rpx 0}.profile-specialty{font-size:27rpx;color:#77746f;margin-top:18rpx}.profile-focus{display:flex;flex-wrap:wrap;gap:10rpx;justify-content:center;margin-top:23rpx}.profile-focus text{font-size:22rpx;color:#625d55;padding:7rpx 14rpx;background:#fff;border:1rpx solid #eae7e1}.demo-notice{font-size:23rpx;color:#786548;line-height:1.8;background:#fcfbf9;border:1rpx solid #eae7e1;padding:22rpx 26rpx;margin-bottom:25rpx}.section-heading{display:flex;align-items:center;gap:12rpx;margin-bottom:20rpx}.section-heading .section-title{margin:0;font-size:29rpx}.section-rule{height:23rpx;width:5rpx;background:#b79a6b}.bio-paragraph{color:#625d55;font-size:26rpx;line-height:2}.detail-tip{font-size:22rpx;color:#77746f;line-height:1.9;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #eae7e1}.qualification-item{display:flex;align-items:center;gap:17rpx;padding:18rpx 0}.qualification-item+.qualification-item{border-top:1rpx solid #eae7e1}.qualification-icon{height:50rpx;width:50rpx;flex-shrink:0;background:#f7f5f1;color:#9e8257;line-height:50rpx;text-align:center;font-size:25rpx}.qualification-name{font-size:26rpx;margin-bottom:7rpx}.qualification-item .small{font-size:22rpx}.consultation-fee{margin-top:25rpx;background:#fcfbf9;padding:23rpx}.consultation-fee .row{font-size:25rpx;color:#77746f;align-items:flex-start}.fee{font-size:34rpx;font-weight:600;line-height:1.3;white-space:nowrap;color:#292d30}.fee text{font-size:21rpx;font-weight:400;color:#77746f}.consultation-fee>.small{font-size:22rpx;color:#77746f;line-height:1.9;margin-top:14rpx}

