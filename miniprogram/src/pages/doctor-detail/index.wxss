.doctor-detail-page{padding-top:16rpx}.doctor-profile{position:relative;overflow:hidden;background:linear-gradient(145deg,#e0f0ee,#eef5f9);border:1rpx solid #daeae9;border-radius:32rpx;padding:42rpx 28rpx 36rpx;text-align:center;margin-bottom:24rpx}.profile-orbit{position:absolute;width:550rpx;height:550rpx;border:1rpx solid #d5e7e2;border-radius:50%;left:calc(50% - 275rpx);top:-320rpx;box-shadow:0 0 0 44rpx #edf7f080,0 0 0 90rpx #e0ede840}.profile-portrait{position:relative;margin:0 auto 26rpx;width:165rpx;height:184rpx;border-radius:30rpx;background:#cfe5df;overflow:hidden;border:7rpx solid #ffffffd9;box-shadow:0 10rpx 30rpx #47776a0d}.portrait-head{position:absolute;width:61rpx;height:66rpx;background:#89aaa4;border-radius:50%;top:25rpx;left:45rpx}.portrait-body{position:absolute;top:99rpx;width:145rpx;height:107rpx;border-radius:70rpx 70rpx 0 0;background:#fff;left:4rpx}.profile-portrait text{position:absolute;right:11rpx;bottom:7rpx;color:#64958a;font-size:23rpx;font-weight:600}.doctor-profile>.eyebrow{position:relative;font-size:17rpx;letter-spacing:3rpx;color:#80a49b}.profile-name{font-size:42rpx;font-weight:700;line-height:1.5;position:relative;margin:13rpx 0}.profile-specialty{font-size:27rpx;color:#577c7b;margin-top:18rpx;position:relative}.profile-focus{position:relative;display:flex;flex-wrap:wrap;gap:10rpx;justify-content:center;margin-top:23rpx}.profile-focus text{font-size:22rpx;color:#638880;padding:7rpx 14rpx;border-radius:10rpx;background:#ffffffaa}.demo-notice{font-size:23rpx;color:#948267;line-height:1.8;background:#fbf7ef;border:1rpx solid #f0e7d8;padding:22rpx 26rpx;border-radius:20rpx;margin-bottom:25rpx}.section-heading{display:flex;align-items:center;gap:12rpx;margin-bottom:20rpx}.section-heading .section-title{margin:0;font-size:29rpx}.section-rule{height:23rpx;width:5rpx;background:#2b9298;border-radius:4rpx}.bio-paragraph{color:#6c838e;font-size:26rpx;line-height:2}.detail-tip{font-size:22rpx;color:#91a3aa;line-height:1.9;margin-top:24rpx;padding-top:20rpx;border-top:1rpx dashed #e3ecef}.qualification-item{display:flex;align-items:center;gap:17rpx;padding:18rpx 0}.qualification-item+.qualification-item{border-top:1rpx solid #edf1f3}.qualification-icon{height:50rpx;width:50rpx;flex-shrink:0;border-radius:14rpx;background:#edf6f2;color:#69a08c;line-height:50rpx;text-align:center;font-size:25rpx}.qualification-name{font-size:26rpx;margin-bottom:7rpx}.qualification-item .small{font-size:22rpx}.booking-card{border-color:#d5e9e9}.consultation-fee{margin-top:25rpx;border-radius:17rpx;background:#f1f8f7;padding:23rpx}.consultation-fee .row{font-size:25rpx;color:#69908c;align-items:flex-start}.fee{font-size:34rpx;font-weight:700;line-height:1.3;white-space:nowrap;color:#1c7f83}.fee text{font-size:21rpx;font-weight:400;color:#89a5a3}.consultation-fee>.small{font-size:22rpx;color:#91a7a4;line-height:1.9;margin-top:14rpx}
