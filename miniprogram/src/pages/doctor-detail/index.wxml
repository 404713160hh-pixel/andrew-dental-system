<view class="page doctor-detail-page">
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="secondary space" bindtap="load">重新加载</button></view>
  <block wx:if="{{doctor}}">
    <view class="doctor-profile"><view wx:if="{{doctor.hasPortrait}}" class="profile-portrait"><image class="doctor-sprite" src="/assets/demo-doctors-grid.jpg" mode="scaleToFill" style="left: -{{doctor.portraitCol * 100}}%; top: -{{doctor.portraitRow * 100}}%;" aria-label="AI 生成的虚构医生示意图"/></view><view class="profile-summary"><view class="profile-name">{{doctor.shortName}}</view><view class="profile-specialty">{{doctor.specialty}}</view></view></view>
    <view wx:if="{{doctor.isDemo}}" class="demo-notice">人物、照片、经历及资格均为虚构。</view>
    <view class="card"><view class="section-heading"><view class="section-rule"></view><view class="section-title">医生介绍</view></view><view class="bio-paragraph">{{doctor.bioLabel || '暂无简介'}}</view></view>
    <view class="card"><view class="section-heading"><view class="section-rule"></view><view class="section-title">资格信息</view></view><view wx:for="{{doctor.qualificationRows}}" wx:key="id" class="qualification-item"><view class="grow"><view class="qualification-name">{{item.name}}</view><view class="muted small">{{item.validityLabel}}</view></view></view><view wx:if="{{!doctor.qualificationRows.length}}" class="muted">暂无资格信息</view></view>
    <view class="card booking-card"><view class="section-heading"><view class="section-rule"></view><view class="section-title">查看排班</view></view>
      <block wx:if="{{clinics.length}}"><text class="label">门诊</text><picker range="{{clinics}}" range-key="name" value="{{clinicIndex}}" bindchange="clinicChange"><view class="picker">{{clinics[clinicIndex].name}} ▾</view></picker><text class="label">预约项目</text><picker range="{{services}}" range-key="name" value="{{serviceIndex}}" bindchange="serviceChange" disabled="{{!services.length}}"><view class="picker">{{services[serviceIndex].name || '暂无可预约项目'}} ▾</view></picker><view wx:if="{{services.length}}" class="consultation-fee"><view class="row"><text>本次参考费</text><text class="fee">¥{{services[serviceIndex].priceLabel}} <text>/ {{services[serviceIndex].unit}}</text></text></view><view class="small">约 {{services[serviceIndex].durationMinutes}} 分钟 · 治疗费用面诊确认</view></view><button class="primary space" bindtap="book" disabled="{{loading || !services.length}}">查看时段</button></block>
      <view wx:else class="empty space">暂无可预约排班</view>
    </view>
  </block>
</view>
