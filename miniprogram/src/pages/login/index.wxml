<view class="page">
  <view class="login-intro"><view class="title">{{mode === 'consent' ? '就诊资料告知' : mode === 'register' ? '患者注册' : mode === 'linked' ? '关联就诊档案' : '患者登录'}}</view><view class="login-lead">{{mode === 'consent' ? '请阅读资料用途，并分别确认个人资料与健康信息处理。' : mode === 'linked' ? '使用前台核验后提供的一次性凭证关联本人档案。' : mode === 'register' ? '创建本人账号并填写就诊资料。' : '登录后查看和管理本人预约及资料。'}}</view></view>
  <view class="card">
    <view wx:if="{{mode !== 'consent'}}" class="login-tabs"><view class="{{mode === 'login' ? 'active' : ''}}" data-mode="login" bindtap="mode">账号登录</view><view class="{{mode === 'register' ? 'active' : ''}}" data-mode="register" bindtap="mode">注册账号</view><view class="{{mode === 'linked' ? 'active' : ''}}" data-mode="linked" bindtap="mode">关联已有档案</view></view>
    <view wx:if="{{mode === 'login'}}" class="patient-account-presets"><view class="preset-heading">演示患者</view><view class="patient-account-grid"><button wx:for="{{patientAccounts}}" wx:key="username" class="patient-account {{selectedPatientAccount === item.username ? 'active' : ''}}" data-username="{{item.username}}" bindtap="selectPatient" disabled="{{busy || loading}}" aria-label="{{item.label}}，账号 {{item.username}}" hover-class="card-pressed"><text class="patient-account-label">{{item.label}}</text><text class="patient-account-name">{{item.username}}</text></button></view><view class="preset-help"><text class="preset-password">演示密码：admin123</text><text>选择账号后手动输入密码。</text></view></view>
    <block wx:if="{{mode !== 'consent'}}"><text class="label">患者账号</text><input class="input" value="{{username}}" data-field="username" bindinput="input" placeholder="选择演示患者或输入账号" maxlength="80" disabled="{{busy}}" /><text class="label">密码</text><input class="input" value="{{password}}" data-field="password" bindinput="input" password placeholder="输入账号密码" maxlength="128" disabled="{{busy}}" /></block>
    <block wx:if="{{mode === 'register'}}"><view class="muted space">账号 3–80 位，支持字母、数字和 . _ -；密码至少 12 位。</view><patient-form value="{{profile}}" disabled="{{busy}}" bindchange="profileChange" /></block>
    <block wx:if="{{mode === 'linked'}}"><view class="muted space">请向前台核实身份并领取一次性凭证。</view><text class="label">一次性凭证</text><input class="input" value="{{code}}" data-field="code" bindinput="input" placeholder="输入前台提供的凭证" maxlength="24" disabled="{{busy}}" /><text class="label">档案出生日期</text><picker mode="date" value="{{linkedBirthDate}}" bindchange="linkedDate" disabled="{{busy}}"><view class="picker">{{linkedBirthDate || '选择出生日期'}} ▾</view></picker></block>
    <block wx:if="{{mode === 'register' || mode === 'linked' || mode === 'consent'}}">
      <view class="section-title space">隐私与资料使用</view>
      <navigator class="privacy-link" url="/pages/privacy/index" hover-class="tap-soft">
        <text>阅读《小程序隐私协议》</text><text aria-hidden="true">›</text>
      </navigator>
      <view wx:if="{{notice}}" class="consent-lead">请阅读协议后，分别确认以下两项。</view>
      <view wx:else class="error">隐私协议版本读取失败。<button class="secondary space" bindtap="load" disabled="{{loading}}">重新读取</button></view>
      <checkbox-group bindchange="consentChange"><label class="consent-option"><checkbox value="notice" checked="{{acceptedNotice}}" />我已阅读，同意连锁门诊为预约和接诊使用个人资料</label><label class="consent-option"><checkbox value="sensitive" checked="{{acceptedSensitive}}" />我单独同意为接诊处理过敏等健康信息</label>
      <block wx:if="{{minor}}"><view class="muted space">未满14周岁须由父母或其他监护人填写并同意。此处记录填写信息，线下还需按机构流程核验监护关系。</view><input class="input" value="{{guardianName}}" data-field="guardianName" bindinput="input" placeholder="监护人姓名" /><input class="input" value="{{guardianRelationship}}" data-field="guardianRelationship" bindinput="input" placeholder="与患者的关系" /><label class="consent-option"><checkbox value="guardian" checked="{{guardianAccepted}}" />我是父母或其他监护人，同意处理该患者的信息</label></block></checkbox-group>
    </block>
    <view wx:if="{{error}}" class="error space">{{error}}</view><button class="primary space" loading="{{busy}}" disabled="{{busy || loading}}" bindtap="submit">{{mode === 'login' ? '患者登录' : mode === 'consent' ? '确认并继续' : '注册并登录'}}</button>
  </view>
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:if="{{config.demoLoginEnabled && mode === 'login'}}" class="card"><view class="section-title">演示账号</view><view class="muted">虚构账号，请勿输入真实医疗信息。</view><block wx:for="{{config.demoAccounts}}" wx:key="username"><button wx:if="{{item.portal === 'patient'}}" class="secondary space" data-username="{{item.username}}" bindtap="demo" disabled="{{busy}}">{{item.displayName}} · 演示登录</button></block></view>

</view>
