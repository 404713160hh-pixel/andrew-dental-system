.login-intro{padding:8rpx 0 24rpx}.login-intro .title{margin:0;color:#111827;font-family:inherit;font-size:38rpx;font-weight:700;line-height:1.45}.page>.card{padding:26rpx;border:1rpx solid #e5eaf2;border-radius:20rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(15,23,42,.04)}.login-tabs{display:flex;gap:22rpx;flex-wrap:wrap;border-bottom:1rpx solid #e5eaf2}.login-tabs view{padding:8rpx 0 16rpx;color:#64748b;font-size:24rpx}.login-tabs .active{border-bottom:4rpx solid #2563eb;color:#1d4ed8;font-weight:700}.privacy-note{margin:16rpx 0;padding:18rpx;border:1rpx solid #dbeafe;border-radius:14rpx;background:#eff6ff;color:#334155;font-size:24rpx;line-height:1.8;word-break:break-all}.consent-option{display:flex;align-items:flex-start;gap:10rpx;margin:18rpx 0;color:#1e293b;font-size:24rpx;line-height:1.7}.consent-option checkbox{flex-shrink:0;margin-top:3rpx}
.patient-account-presets{padding-top:22rpx}.preset-heading{margin-bottom:14rpx;color:#334155;font-size:24rpx;font-weight:650}.patient-account-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}.patient-account{display:flex;flex-direction:column;align-items:flex-start;gap:7rpx;min-width:0;margin:0;padding:20rpx;border:1rpx solid #e5eaf2;border-radius:16rpx;background:#f8fbff;color:#1e293b;text-align:left;line-height:1.5}.patient-account::after{border:0}.patient-account.active{border-color:#2563eb;background:#eff6ff;box-shadow:inset 0 0 0 1rpx #2563eb}.patient-account-label{font-size:26rpx;font-weight:650}.patient-account-name{color:#64748b;font-family:ui-monospace,Consolas,monospace;font-size:22rpx;word-break:break-all}.preset-help{margin-top:12rpx;color:#64748b;font-size:22rpx;line-height:1.75}.preset-password{display:block;color:#334155;font-weight:600}
@media(max-width:350px){.page>.card{padding:20rpx}.login-tabs{gap:16rpx}.login-tabs view{font-size:22rpx}.patient-account{padding:16rpx}}
.login-lead{margin-top:8rpx;color:#64748b;font-size:24rpx;line-height:1.75}.consent-lead{margin-top:12rpx;color:#64748b;font-size:23rpx;line-height:1.75}
.privacy-link { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-height: 84rpx; padding: 20rpx 22rpx; margin: 12rpx 0; background: #eff6ff; color: #1d4ed8; border: 1rpx solid #dbeafe; border-radius: 14rpx; font-weight: 650; }
