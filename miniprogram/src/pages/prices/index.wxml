<view class="page prices-page">
  <view class="price-hero"><view class="price-heading">项目参考</view><text wx:if="{{referenceYearLabel}}" class="price-subtitle">{{referenceYearLabel}} 年资料</text></view>
  <view class="source-notice">用户提供的未核验参考价，非门诊报价；治疗费以面诊为准，咨询费见预约页。</view>
  <view class="price-search"><text>⌕</text><input value="{{keyword}}" bindinput="searchInput" placeholder="搜索项目或材料" maxlength="80" confirm-type="search" /></view>
  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="category-tabs"><view wx:for="{{categories}}" wx:key="*this" class="category-tab {{selectedCategory === item ? 'active' : ''}}" data-category="{{item}}" bindtap="categoryTap">{{item}}</view></view></scroll-view>
  <view class="price-results"><view class="section-title">{{selectedCategory === '全部' ? '全部项目' : selectedCategory}}</view><text class="small muted">{{filteredItems.length}} 项</text></view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="secondary space" bindtap="load">重新加载</button></view>
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:for="{{filteredItems}}" wx:key="id" class="card reference-card">
    <view class="reference-top"><text class="reference-category">{{item.category}}</text><text class="reference-year">{{item.referenceYear}} 资料</text></view>
    <view class="reference-name" data-id="{{item.id}}" bindtap="toggle">{{item.name}}</view>
    <view class="reference-price"><text class="currency">¥</text><text>{{item.priceLabel}}</text><text class="price-unit">/ {{item.unit}}</text></view>
    <view class="reference-actions"><text class="reference-expand" data-id="{{item.id}}" bindtap="toggle">{{expandedId === item.id ? '收起 −' : '项目说明 ＋'}}</text><button wx:if="{{item.bookingServiceId}}" class="consult-button" data-id="{{item.id}}" bindtap="consult">查看时段 →</button><text wx:else class="small muted">暂无预约入口</text></view>
    <view wx:if="{{expandedId === item.id}}" class="reference-expanded"><view>{{item.description || '项目范围及材料费用以面诊为准。'}}</view><view class="reference-source">来源：{{item.sourceLabel}}</view></view>
  </view>
  <view wx:if="{{!loading && !error && !filteredItems.length}}" class="empty">暂无匹配项目</view>
</view>
