.prices-page{padding-top:18rpx}.price-hero{position:relative;overflow:hidden;border:1rpx solid #dce9ee;border-radius:31rpx;padding:34rpx 29rpx 32rpx;background:linear-gradient(130deg,#e7f1f5,#edf5f2);margin-bottom:23rpx}.price-heading{font-size:45rpx;line-height:1.5;font-weight:700;margin:15rpx 0 18rpx;position:relative;color:#2e5965;max-width:540rpx}.price-subtitle{font-size:22rpx;line-height:1.9;color:#85a0a9;position:relative;max-width:540rpx}.price-hero>.eyebrow{font-size:17rpx;letter-spacing:2rpx;position:relative;color:#76a2aa}.price-orbit{position:absolute;height:330rpx;width:330rpx;border:1rpx solid #d8e7e2;border-radius:50%;top:-70rpx;right:-180rpx;box-shadow:0 0 0 40rpx #e2ede880,0 0 0 80rpx #e6f0ec60}.reference-seal{position:absolute;right:25rpx;bottom:28rpx;padding:8rpx 13rpx;font-size:19rpx;border:1rpx solid #bfd4cf;color:#86a39a;border-radius:8rpx;transform:rotate(-8deg);background:#f4f9f4bb}.source-notice{padding:23rpx 25rpx;background:#fbf8f1;border:1rpx solid #eee6d8;border-radius:21rpx;margin-bottom:24rpx;font-size:23rpx;line-height:1.9;color:#9a896f}.source-title{font-size:25rpx;font-weight:650;color:#8e7b5e;margin-bottom:9rpx}.source-note{padding-top:12rpx;margin-top:13rpx;border-top:1rpx dashed #e5dac5;font-size:22rpx;color:#aa997e}.price-search{display:flex;align-items:center;gap:14rpx;background:#fff;border:1rpx solid #e1e9ee;border-radius:20rpx;padding:17rpx 23rpx;margin-bottom:23rpx}.price-search>text{color:#8da8b4;font-size:36rpx;line-height:1}.price-search input{font-size:25rpx;height:47rpx;flex:1;min-width:0;color:#526f7c}.category-scroll{white-space:nowrap;width:100%;margin-bottom:18rpx}.category-tabs{display:flex;gap:13rpx;padding-bottom:8rpx;width:max-content;min-width:100%}.category-tab{flex-shrink:0;padding:11rpx 24rpx;border-radius:26rpx;font-size:23rpx;background:#edf3f6;color:#8299a6;border:1rpx solid #e5edf1}.category-tab.active{background:#147f89;color:#fff;border-color:#147f89}.price-results{display:flex;align-items:center;justify-content:space-between;padding:7rpx 2rpx 18rpx}.price-results>.section-title{font-size:28rpx;margin:0}.reference-card{padding:26rpx 27rpx}.reference-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:18rpx}.reference-category{font-size:20rpx;color:#6a9895;background:#edf6f3;border-radius:8rpx;padding:5rpx 11rpx}.reference-year{font-size:20rpx;color:#b0bfc5}.reference-name{font-size:29rpx;font-weight:650;line-height:1.6;color:#3a5d6c;word-break:break-all}.reference-price{display:flex;gap:5rpx;align-items:baseline;flex-wrap:wrap;font-size:42rpx;color:#267b86;font-weight:650;line-height:1.6;margin-top:13rpx}.reference-price>.currency{font-size:25rpx;font-weight:400}.reference-price>.price-unit{font-size:22rpx;font-weight:400;color:#98adb6;margin-left:6rpx}.reference-source{font-size:21rpx;line-height:1.9;color:#a59579;margin-top:10rpx}.reference-actions{display:flex;align-items:center;justify-content:space-between;gap:15rpx;margin-top:23rpx;border-top:1rpx solid #edf1f3;padding-top:20rpx}.reference-expand{font-size:23rpx;color:#8ba2ac}.consult-button{margin:0;padding:10rpx 15rpx;line-height:1.5;font-size:23rpx;color:#367e88;background:#eef7f7;border-radius:11rpx;font-weight:500}.consult-button::after{border:0}.reference-expanded{font-size:24rpx;color:#7b939e;line-height:1.95;background:#f6f9fa;border-radius:15rpx;padding:20rpx 21rpx;margin-top:22rpx}.expanded-note{font-size:22rpx;color:#9bafb7;border-top:1rpx dashed #dfe9ed;margin-top:18rpx;padding-top:15rpx}
