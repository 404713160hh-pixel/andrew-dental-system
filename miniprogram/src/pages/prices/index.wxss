.prices-page{padding-top:32rpx}.price-hero{display:flex;align-items:baseline;justify-content:space-between;gap:16rpx;margin-bottom:18rpx}.price-heading{color:#111827;font-size:36rpx;font-weight:700;line-height:1.45}.price-subtitle{color:#64748b;font-size:22rpx;line-height:1.7}.source-notice{margin-bottom:20rpx;padding:18rpx 20rpx;border:1rpx solid #bfdbfe;border-radius:14rpx;background:#eff6ff;color:#1e40af;font-size:23rpx;line-height:1.8}.price-search{display:flex;align-items:center;gap:12rpx;margin-bottom:18rpx;padding:14rpx 18rpx;border:1rpx solid #dbeafe;border-radius:14rpx;background:#fff}.price-search>text{color:#2563eb;font-size:34rpx;line-height:1}.price-search input{flex:1;min-width:0;height:48rpx;color:#111827;font-size:25rpx}.category-scroll{width:100%;margin-bottom:16rpx;white-space:nowrap}.category-tabs{display:flex;gap:12rpx;width:max-content;min-width:100%;padding-bottom:6rpx}.category-tab{flex-shrink:0;padding:11rpx 20rpx;border:1rpx solid #e5eaf2;border-radius:999rpx;background:#fff;color:#475569;font-size:23rpx}.category-tab.active{border-color:#2563eb;background:#2563eb;color:#fff}.price-results{display:flex;align-items:center;justify-content:space-between;padding:6rpx 2rpx 16rpx}.price-results>.section-title{margin:0;font-size:29rpx}.reference-card{margin-bottom:18rpx;padding:24rpx;border:1rpx solid #e5eaf2;border-radius:20rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(15,23,42,.035)}.reference-top{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10rpx;margin-bottom:16rpx}.reference-category{padding:5rpx 12rpx;border-radius:999rpx;background:#eff6ff;color:#1d4ed8;font-size:20rpx}.reference-year{color:#64748b;font-size:20rpx}.reference-name{color:#111827;font-size:29rpx;font-weight:650;line-height:1.55;word-break:break-all}.reference-price{display:flex;align-items:baseline;flex-wrap:wrap;gap:5rpx;margin-top:10rpx;color:#1d4ed8;font-size:38rpx;font-weight:700;line-height:1.55}.reference-price>.currency{font-size:24rpx;font-weight:500}.reference-price>.price-unit{margin-left:5rpx;color:#64748b;font-size:22rpx;font-weight:400}.reference-actions{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14rpx;margin-top:20rpx;padding-top:16rpx;border-top:1rpx solid #eef2f7}.reference-expand{color:#2563eb;font-size:23rpx}.consult-button{margin:0;padding:10rpx 16rpx;border:1rpx solid #bfdbfe;border-radius:12rpx;background:#eff6ff;color:#1d4ed8;font-size:23rpx;font-weight:600;line-height:1.5}.consult-button::after{border:0}.reference-expanded{margin-top:18rpx;padding:18rpx;border-radius:14rpx;background:#f5f8ff;color:#334155;font-size:24rpx;line-height:1.85;word-break:break-all}.reference-source{margin-top:14rpx;padding-top:12rpx;border-top:1rpx solid #dbeafe;color:#64748b;font-size:21rpx;line-height:1.8}
@media(max-width:350px){.reference-card{padding:20rpx}.price-heading{font-size:33rpx}.reference-price{font-size:34rpx}}
.price-results .small{margin-top:3rpx}.result-mark{padding:6rpx 12rpx;border-radius:999rpx;background:#eff6ff;color:#2563eb;font-size:20rpx}
