<view class="page confirm-page"><view wx:if="{{context}}"><view class="journey-progress"><view class="journey-item passed"><view class="journey-number">1</view><text>门诊项目</text></view><view class="journey-item passed"><view class="journey-number">2</view><text>选择医生</text></view><view class="journey-item passed"><view class="journey-number">3</view><text>日期时段</text></view><view class="journey-item current"><view class="journey-number">4</view><text>核对资料</text></view><view class="journey-item "><view class="journey-number">5</view><text>预约完成</text></view></view></view>
  <view class="title">{{context.oldAppointmentId ? '确认改期' : context.isFollowup ? '确认复诊预约' : '确认预约'}}</view>
  <view wx:if="{{context}}" class="hold-banner {{expired ? 'expired' : ''}}"><view><view class="small">{{pending ? '提交结果待确认' : expired ? '短时占位已到期' : '正在为你短时保留'}}</view><view wx:if="{{!pending}}" class="countdown">{{remaining}}</view></view><view class="hold-note">{{pending ? '请先核对原操作结果' : expired ? '请返回重新查询时段' : '请在倒计时内确认预约'}}</view></view>
  <view wx:if="{{!context && !pending}}" class="empty">暂无待确认时段。<button class="primary space" bindtap="chooseAgain">返回选择</button></view>
  <view wx:if="{{context}}" class="card confirm-slot"><view class="card-kicker">就诊安排</view><view class="section-title">{{context.hold.slot.serviceName}}</view><view class="detail-label">就诊时间</view><view class="appointment-time">{{dateLabel}}—{{endLabel}}</view><view class="divider"></view><view class="row"><text class="muted">门诊</text><text>{{context.hold.slot.clinicName}}</text></view><view class="row space"><text class="muted">医生</text><view class="demo-label-row"><text>{{context.hold.slot.doctorName}}</text><text wx:if="{{context.doctorIsDemo}}" class="demo-badge">虚构医生</text></view></view><view class="row space"><text class="muted">时长</text><text>{{context.hold.slot.durationMinutes}} 分钟</text></view><view class="row space"><text class="muted">本次参考费</text><text>¥{{priceLabel}}</text></view><view class="muted small space">仅本次参考费，后续治疗费用以面诊为准。无需在线支付。</view></view>
  <view wx:if="{{loading}}" class="loading">加载中…</view><view wx:if="{{patient}}" class="card confirm-patient"><view class="card-kicker">信息核对</view><view class="row"><view class="section-title">就诊人</view><text class="link small" bindtap="profile">修改资料 →</text></view><view class="demo-label-row"><view class="patient-name">{{patient.name}}<text>账号本人</text></view><text wx:if="{{patient.isDemo}}" class="demo-badge">虚构患者</text></view><view class="muted">出生日期 {{patient.birthDate}}</view><view class="muted">联系电话 {{patient.phone}}</view><view class="allergy-status">{{allergyLabel}}</view><view wx:if="{{patient.allergyStatus === 'known'}}" class="small">{{patient.allergies}}</view><view wx:if="{{patient.allergyStatus === 'unknown'}}" class="muted small">过敏情况待核实，请告知医务人员。</view></view>
  <view wx:if="{{context}}" class="card confirm-rules"><view class="card-kicker">提交前确认</view><view class="section-title">预约规则</view><view class="muted">取消或改期需提前 {{context.hold.policy.cancellationNoticeMinutes}} 分钟；临近就诊请联系门诊。</view><view wx:if="{{context.oldAppointmentId}}" class="notice space">改期成功前，原预约仍有效。<text class="label">改期原因 *</text><textarea class="textarea" bindinput="reasonInput" value="{{reason}}" maxlength="500" placeholder="请简要说明改期原因" /></view><checkbox-group bindchange="checks"><label class="checkline"><checkbox value="patient" checked="{{patientConfirmed}}" color="#2563EB" /><text>我已核对就诊人和联系电话。</text></label><label class="checkline"><checkbox value="rules" checked="{{rulesAccepted}}" color="#2563EB" /><text>我已阅读预约规则。</text></label></checkbox-group></view>
  <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{pending}}" class="notice"><view class="section-title">提交结果待确认</view><view>网络恢复后请核对或重试原操作。</view><view class="buttons space"><button class="secondary" bindtap="inspect" disabled="{{busy}}">核对结果</button><button class="secondary" bindtap="retry" disabled="{{busy}}">重试原操作</button></view></view>
  <button wx:if="{{context && !pending}}" class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy || loading || expired || !patientConfirmed || !rulesAccepted}}">{{context.oldAppointmentId ? '确认改期' : context.isFollowup ? '确认复诊预约' : '确认预约'}}</button>
</view>
