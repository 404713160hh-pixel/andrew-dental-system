.hold-banner{background:#e3f3f0;border:1rpx solid #bce0d7;border-radius:24rpx;padding:24rpx 28rpx;display:flex;justify-content:space-between;align-items:center;color:#237b6d;margin-bottom:26rpx}.hold-banner.expired{background:#f3f1ed;color:#8e7964;border-color:#e6ded3}.countdown{font-size:48rpx;font-weight:700;letter-spacing:2rpx}.hold-note{font-size:23rpx;text-align:right;white-space:pre-line}.appointment-time{font-size:33rpx;font-weight:700;margin-top:8rpx}.patient-name{font-size:34rpx;font-weight:650;margin-bottom:12rpx}.patient-name text{font-size:21rpx;border-radius:10rpx;background:#f0f5f8;color:#658293;padding:4rpx 12rpx;margin-left:15rpx;font-weight:400}.allergy-status{background:#f4f8fa;padding:18rpx;border-radius:14rpx;margin:22rpx 0 12rpx;font-size:25rpx}
