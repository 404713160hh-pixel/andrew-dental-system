 .hold-banner{background:#f8fafc;border:1rpx solid #e5eaf2;border-left:4rpx solid #2563eb;border-radius:14rpx;padding:28rpx;display:flex;justify-content:space-between;align-items:center;gap:24rpx;color:#475569;margin-bottom:28rpx}.hold-banner.expired{background:#f8fafc;color:#64748b}.countdown{font-size:48rpx;font-weight:600;letter-spacing:2rpx;font-variant-numeric:tabular-nums;color:#111827}.hold-note{font-size:23rpx;line-height:1.8;text-align:right;white-space:pre-line;max-width:300rpx}.appointment-time{font-size:30rpx;font-weight:600;line-height:1.65;margin-top:12rpx;word-break:break-word}.patient-name{font-size:32rpx;font-weight:600;line-height:1.65;margin-bottom:14rpx}.patient-name text{font-size:21rpx;background:#f8fafc;color:#64748b;padding:4rpx 12rpx;margin-left:15rpx;font-weight:400}.allergy-status{background:#eff6ff;padding:22rpx;border-radius:10rpx;margin:24rpx 0 14rpx;font-size:25rpx;line-height:1.8}

.confirm-page>.title{font-size:38rpx;line-height:1.45;margin-bottom:24rpx}.confirm-page .card>.row{align-items:flex-start;gap:24rpx}.confirm-page .card>.row>text:first-child{flex-shrink:0;max-width:38%}.confirm-page .card>.row>text:last-child{text-align:right;line-height:1.75}.confirm-page .card>.row>.demo-label-row{flex:1;min-width:0;justify-content:flex-end}.confirm-page .card>.muted{line-height:1.85}.confirm-page .checkline text{line-height:1.85}.confirm-page>.primary{margin-top:12rpx}

/* Keep the hold status and review sections visually distinct. */
.confirm-page .hold-banner{background:#eff6ff;border-color:#e5eaf2;border-left-color:#2563eb;color:#1d4ed8}
.confirm-page .hold-banner.expired{background:#fff7ed;border-color:#fed7aa;border-left-color:#d97706;color:#92400e}
.confirm-page .card{border-color:#e5eaf2}
.confirm-page .card-kicker{font-size:21rpx;font-weight:600;color:#2563eb;letter-spacing:1rpx;margin-bottom:8rpx}
.confirm-page .confirm-slot{box-shadow:0 8rpx 28rpx rgba(37,99,235,.05)}
.confirm-page .allergy-status{background:#f8fafc;color:#64748b}
.confirm-page .confirm-rules .checkline{padding-top:16rpx;border-top:1rpx solid #eef2f7}

/* Five actual stages; only reached stages are highlighted. */
.journey-progress{display:flex;justify-content:space-between;gap:4rpx;background:#fff;border:1rpx solid #e5eaf2;border-radius:20rpx;padding:20rpx 12rpx 18rpx;margin-bottom:28rpx}
.journey-item{flex:1;min-width:0;text-align:center;font-size:20rpx;line-height:1.35;color:#64748b;white-space:nowrap}
.journey-number{width:38rpx;height:38rpx;line-height:38rpx;margin:0 auto 8rpx;border-radius:50%;background:#f8fafc;color:#64748b;font-size:21rpx;font-weight:600}
.journey-item.passed .journey-number{background:#e8f1ff;color:#1d4ed8}
.journey-item.current{color:#1d4ed8;font-weight:600}
.journey-item.current .journey-number{background:#2563eb;color:#fff}
@media(max-width:350px){.journey-progress{padding-left:4rpx;padding-right:4rpx}.journey-item{font-size:18rpx}}
