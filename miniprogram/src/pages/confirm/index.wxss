 .hold-banner{background:#fcfbf9;border:1rpx solid #eae7e1;border-left:4rpx solid #b79a6b;border-radius:14rpx;padding:28rpx;display:flex;justify-content:space-between;align-items:center;gap:24rpx;color:#625d55;margin-bottom:28rpx}.hold-banner.expired{background:#f7f5f1;color:#77746f}.countdown{font-size:48rpx;font-weight:600;letter-spacing:2rpx;font-variant-numeric:tabular-nums;color:#252522}.hold-note{font-size:23rpx;line-height:1.8;text-align:right;white-space:pre-line;max-width:300rpx}.appointment-time{font-size:30rpx;font-weight:600;line-height:1.65;margin-top:12rpx;word-break:break-word}.patient-name{font-size:32rpx;font-weight:600;line-height:1.65;margin-bottom:14rpx}.patient-name text{font-size:21rpx;background:#f7f5f1;color:#77746f;padding:4rpx 12rpx;margin-left:15rpx;font-weight:400}.allergy-status{background:#f7f5ef;padding:22rpx;border-radius:10rpx;margin:24rpx 0 14rpx;font-size:25rpx;line-height:1.8}

.confirm-page>.title{font-size:42rpx;line-height:1.5;margin-bottom:28rpx}.confirm-page .card>.row{align-items:flex-start;gap:24rpx}.confirm-page .card>.row>text:first-child{flex-shrink:0;max-width:38%}.confirm-page .card>.row>text:last-child{text-align:right;line-height:1.75}.confirm-page .card>.row>.demo-label-row{flex:1;min-width:0;justify-content:flex-end}.confirm-page .card>.muted{line-height:1.85}.confirm-page .checkline text{line-height:1.85}.confirm-page>.primary{margin-top:12rpx}
