.profile-hero{display:flex;align-items:center;gap:20rpx;margin-bottom:24rpx;padding:22rpx 0 28rpx;border-bottom:1rpx solid #dbeafe}.profile-identity{flex:1;min-width:0}.profile-hero .title{margin:0 0 6rpx;color:#111827;font-family:inherit;font-size:34rpx;font-weight:700;line-height:1.45;word-break:break-all}.profile-hero .muted{color:#64748b;font-size:24rpx;line-height:1.7}.avatar{width:88rpx;height:88rpx;flex-shrink:0;border:1rpx solid #bfdbfe;border-radius:50%;background:#eff6ff;color:#2563eb;font-size:46rpx;text-align:center;line-height:86rpx}.profile-guest{padding:28rpx;border:1rpx solid #e5eaf2;border-radius:20rpx;background:#fff}.profile-guest .section-title{margin:0 0 10rpx;font-size:30rpx}.profile-guest .muted{line-height:1.8}.profile-guest .primary{width:100%;margin-top:24rpx}.profile-page .nav-card{align-items:center;padding:24rpx;border:1rpx solid #e5eaf2;border-radius:18rpx;background:#fff}.profile-page .nav-card .section-title{margin:0 0 6rpx}.profile-page .nav-card .link{flex-shrink:0;font-size:32rpx}.profile-page>.secondary{margin-top:18rpx}
@media(max-width:350px){.profile-hero{gap:16rpx;padding-bottom:22rpx}.profile-hero .title{font-size:30rpx}.profile-guest{padding:22rpx}.avatar{width:76rpx;height:76rpx;line-height:74rpx;font-size:40rpx}}
.profile-kicker{margin-bottom:4rpx;color:#2563eb;font-size:21rpx;font-weight:650;letter-spacing:1rpx}.patient-id{color:#64748b;font-size:22rpx;line-height:1.7}.profile-scope{margin:12rpx 0 20rpx;padding:16rpx;border-radius:14rpx;background:#eff6ff;color:#334155;font-size:23rpx;line-height:1.8}

.profile-page { padding-top: 24rpx; }
.profile-hero {
  min-height: 164rpx;
  padding: 28rpx;
  border: 1rpx solid #e5eaf2;
  border-radius: 24rpx;
  background: #fff;
}
.profile-hero .title { margin: 0; font-size: 36rpx; word-break: normal; overflow-wrap: anywhere; }
.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  overflow: hidden;
  border: 0;
}
.avatar-photo { width: 100%; height: 100%; }
.avatar-placeholder { width: 60rpx; height: 60rpx; }
.avatar-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; }
.avatar-action {
  margin: 0;
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.5;
}
.avatar-action::after { border: 0; }
.remove-avatar { background: transparent; color: #475569; }
.avatar-privacy { margin-top: 4rpx; color: #64748b; font-size: 21rpx; }
.profile-record-heading { margin-bottom: 12rpx; }
.profile-record-heading .section-title { margin: 0; }
.profile-record-heading button { flex-shrink: 0; }
.profile-field { display: flex; align-items: baseline; justify-content: space-between; gap: 18rpx; padding: 15rpx 0; border-top: 1rpx solid #eef2f7; }
.profile-field text:first-child { color: #64748b; flex-shrink: 0; }
.profile-field text:last-child { min-width: 0; overflow-wrap: anywhere; text-align: right; }
.profile-allergies { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8rpx; }
.profile-allergies text { padding: 4rpx 12rpx; background: #eff6ff; border-radius: 8rpx; }
.profile-privacy-link { color: #1d4ed8; font-size: 25rpx; padding: 16rpx 0; }
