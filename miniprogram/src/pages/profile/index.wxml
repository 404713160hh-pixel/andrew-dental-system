<view class="page profile-page"><view class="profile-hero"><view class="avatar">◎</view><view class="profile-identity"><view class="title">{{signedIn ? displayName : '你好，欢迎来到安德鲁'}}</view><view class="muted">{{signedIn ? '账号本人' : '在这里管理就诊资料与预约'}}</view></view></view>
  <view wx:if="{{!signedIn && logoutNotice}}" class="notice">{{logoutNotice}}</view><view wx:if="{{!signedIn}}" class="card profile-guest"><view class="section-title">安排下一次就诊</view><view class="muted">登录后完善资料，查看和管理预约。</view><button class="primary space" bindtap="login">登录 / 注册</button></view>
  <block wx:if="{{signedIn}}"><view wx:if="{{isDemo}}" class="demo-note space"><text class="demo-badge">虚构患者</text><view>虚构演示资料，请勿填写真实医疗信息。</view></view><view wx:if="{{hasHold}}" class="notice">时段正在保留，保存资料后可继续预约。<button class="secondary space" bindtap="continueHold" disabled="{{busy || loading}}">继续核对预约 →</button></view><view class="card nav-card row" hover-class="card-pressed" bindtap="appointments"><view><view class="section-title">我的预约</view><view class="muted">查看本人预约与变更记录</view></view><text class="link">→</text></view>
    <view wx:if="{{loading}}" class="loading">正在读取就诊资料…</view><view wx:if="{{error}}" class="error">{{error}}<button wx:if="{{needsConsent}}" class="secondary space" bindtap="login">查看并确认隐私告知</button><button wx:else class="secondary space" bindtap="load" disabled="{{busy || loading}}">重新加载本人资料</button></view><view wx:if="{{saved}}" class="success">资料已保存。</view>
    <view wx:if="{{rowVersion}}" class="card"><view class="demo-label-row"><view class="section-title">本人就诊资料</view><text wx:if="{{isDemo}}" class="demo-badge">虚构患者</text></view><view class="muted small">患者编号 {{patientId}}</view><patient-form value="{{profile}}" disabled="{{busy || loading}}" bindchange="change" /><button class="primary space" bindtap="save" loading="{{busy}}" disabled="{{busy || loading}}">保存本人资料</button></view>
    <button class="secondary" bindtap="withdrawConsent" disabled="{{busy || loading}}">撤回隐私同意</button><button class="secondary space" bindtap="logout" disabled="{{busy}}">退出登录</button><view class="footer-note">过敏信息为本人声明，不能代替医生的临床核对。</view>
  </block>
</view>
