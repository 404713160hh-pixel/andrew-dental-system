.doctors-page>.title{font-size:47rpx;line-height:1.45;margin-bottom:18rpx}.page-intro{margin-bottom:28rpx;line-height:1.9}.doctor-filter{display:flex;align-items:center;justify-content:space-between;padding:22rpx 26rpx;gap:20rpx}.doctor-filter .section-title{font-size:27rpx;margin:0 0 3rpx}.filter-choice{display:flex;align-items:center;gap:15rpx;background:#f1f7f8;border:1rpx solid #e2ecef;border-radius:16rpx;padding:14rpx 18rpx;font-size:24rpx;max-width:380rpx;overflow:hidden}.filter-choice text{color:#578591}.team-card{padding:28rpx}.team-top{display:flex;align-items:center;gap:23rpx}.doctor-avatar{width:132rpx;height:148rpx;flex-shrink:0;position:relative;overflow:hidden;background:linear-gradient(140deg,#d6eeeb,#edf6f4);border:1rpx solid #e0efec;border-radius:26rpx}.doctor-avatar.tone-1{background:linear-gradient(140deg,#dfebf4,#f1f7fb);border-color:#e2edf5}.doctor-avatar.tone-2{background:linear-gradient(140deg,#ede9e0,#f9f5eb);border-color:#f0ecdf}.portrait-head{position:absolute;width:45rpx;height:49rpx;left:43rpx;top:22rpx;border-radius:50%;background:#8baba9}.portrait-body{position:absolute;width:116rpx;height:95rpx;left:8rpx;top:77rpx;background:#fff;border-radius:54rpx 54rpx 0 0;box-shadow:0 -6rpx 16rpx #73938d0a}.doctor-avatar>text{position:absolute;bottom:5rpx;right:9rpx;color:#5c8a88;font-size:20rpx;font-weight:600}.tone-1 .portrait-head{background:#8ca3b6}.tone-2 .portrait-head{background:#b2a58b}.name-line{display:flex;align-items:center;gap:10rpx;flex-wrap:wrap}.doctor-name{font-size:31rpx;font-weight:700;line-height:1.45;word-break:break-all}.doctor-specialty{font-size:24rpx;color:#62818c;margin-top:10rpx;line-height:1.7}.doctor-location{font-size:21rpx;color:#94a6ae;margin-top:11rpx;line-height:1.8}.focus-tags{display:flex;gap:10rpx;flex-wrap:wrap;margin-top:24rpx}.focus-tags text{font-size:21rpx;border-radius:10rpx;background:#eff7f7;color:#4a838b;padding:6rpx 13rpx}.doctor-bio{font-size:24rpx;color:#7a909a;line-height:1.9;margin-top:19rpx;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}.demo-inline{font-size:21rpx;color:#9b886c;line-height:1.7;background:#fbf8f1;border-radius:12rpx;padding:12rpx 15rpx;margin-top:19rpx}.team-footer{display:flex;align-items:center;justify-content:space-between;gap:12rpx;border-top:1rpx solid #edf2f4;padding-top:20rpx;margin-top:22rpx}.team-footer .link{font-size:24rpx}.team-footer .small{font-size:20rpx}
