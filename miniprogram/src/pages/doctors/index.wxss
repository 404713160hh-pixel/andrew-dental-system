 .doctors-page>.title{font-size:48rpx;line-height:1.45;margin-bottom:18rpx}.page-intro{margin-bottom:30rpx;line-height:1.9}.doctor-filter{display:flex;align-items:center;justify-content:space-between;padding:22rpx 0;gap:20rpx;border:0;border-top:1rpx solid #eae7e1;border-bottom:1rpx solid #eae7e1}.doctor-filter .section-title{font-size:27rpx;margin:0 0 3rpx}.filter-choice{display:flex;align-items:center;gap:15rpx;background:#fcfbf9;border:1rpx solid #eae7e1;border-radius:6rpx;padding:14rpx 18rpx;font-size:24rpx;max-width:380rpx;overflow:hidden}.filter-choice text{color:#9e8257}
.team-card{padding:28rpx 0;border:0;border-bottom:1rpx solid #eae7e1;border-radius:0}.team-top{display:flex;align-items:center;gap:23rpx}.doctor-avatar{width:180rpx;height:205rpx;flex-shrink:0;position:relative;overflow:hidden;background:#fcfbf9}.doctor-avatar image{width:100%;height:100%;display:block}.doctor-avatar>text{position:absolute;bottom:7rpx;right:7rpx;color:#625b50;font-size:18rpx;background:#fff;padding:3rpx 7rpx}.name-line{display:flex;align-items:center;gap:10rpx;flex-wrap:wrap}.doctor-name{font-family:"Noto Serif SC","Songti SC",serif;font-size:32rpx;font-weight:600;line-height:1.45;word-break:break-all}.doctor-specialty{font-size:24rpx;color:#625d55;margin-top:10rpx;line-height:1.7}.doctor-location{font-size:22rpx;color:#77746f;margin-top:11rpx;line-height:1.8}.focus-tags{display:flex;gap:10rpx;flex-wrap:wrap;margin-top:24rpx}.focus-tags text{font-size:21rpx;border-radius:4rpx;background:#f7f5f1;color:#625d55;padding:6rpx 13rpx}.doctor-bio{font-size:24rpx;color:#77746f;line-height:1.9;margin-top:19rpx;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}.demo-inline{font-size:21rpx;color:#786548;line-height:1.7;background:#fcfbf9;padding:12rpx 15rpx;margin-top:19rpx}.team-footer{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding-top:20rpx;margin-top:22rpx;border-top:1rpx solid #eae7e1}.team-footer .link{font-size:24rpx}.team-footer .small{font-size:20rpx}

.doctor-avatar image.doctor-sprite{position:absolute;width:400%;height:200%;max-width:none}
