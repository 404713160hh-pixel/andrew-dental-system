<view class="page detail-page"><view wx:if="{{success && appointment && appointment.status === 'confirmed'}}"><view class="journey-progress"><view class="journey-item passed"><view class="journey-number">1</view><text>门诊项目</text></view><view class="journey-item passed"><view class="journey-number">2</view><text>选择医生</text></view><view class="journey-item passed"><view class="journey-number">3</view><text>日期时段</text></view><view class="journey-item passed"><view class="journey-number">4</view><text>核对资料</text></view><view class="journey-item current"><view class="journey-number">5</view><text>预约完成</text></view></view></view><view class="detail-heading"><view class="detail-kicker">就诊记录</view><view class="title">预约详情</view></view><view wx:if="{{success}}" class="success-banner"><view class="success-symbol">✓</view><view class="title">{{successTitle}}</view><view class="muted">{{successMessage}}</view></view>
  <view wx:if="{{loading && !appointment}}" class="loading">加载中…</view><view wx:if="{{error}}" class="error"><view wx:if="{{success}}">操作已完成，详情加载失败，请重新读取。</view>{{error}}<button class="secondary space" bindtap="load" disabled="{{loading}}">重新读取</button></view>
  <view wx:if="{{pending}}" class="notice"><view class="section-title">操作结果待确认</view><view>请核对结果后重试原操作。</view><view class="buttons space"><button class="secondary" bindtap="inspect" disabled="{{busy}}">核对结果</button><button class="secondary" bindtap="retry" disabled="{{busy}}">重试原操作</button></view></view>
  <block wx:if="{{appointment}}"><view class="card detail-summary"><view class="row"><view class="detail-label">就诊安排</view><text class="badge {{appointment.status}}">{{appointment.statusLabel}}</text></view><view class="section-title space">{{appointment.serviceName}}</view><view class="detail-time">{{appointment.dateLabel}}<view class="muted">至 {{appointment.endLabel}} · 北京时间</view></view><view class="divider"></view><view class="detail-label">门诊</view><view class="detail-value">{{appointment.clinicName}}</view><view class="muted small">{{appointment.clinicAddress}}</view><view class="row space"><view><view class="detail-label">医生</view><view class="detail-value">{{appointment.doctorName}}</view><text wx:if="{{appointment.doctorIsDemo}}" class="demo-badge space">虚构医生</text></view><view><view class="detail-label">就诊人</view><view class="detail-value">{{appointment.patientName}}</view><text wx:if="{{appointment.patientIsDemo}}" class="demo-badge space">虚构患者</text></view></view><view class="divider"></view><view class="detail-label">预约编号</view><view class="number">{{appointment.appointmentNo}}</view></view>
    <view class="card detail-actions"><view class="section-title">取消与改期</view><view class="muted">取消或改期需提前 {{appointment.policy.cancellationNoticeMinutes}} 分钟。</view><view wx:if="{{appointment.status === 'confirmed' && !changeAllowed && !error && !loading}}" class="notice space">已超过自助变更时间，请联系门诊。</view><view wx:if="{{appointment.status === 'confirmed'}}" class="buttons space"><button class="secondary" bindtap="reschedule" disabled="{{loading || busy || pending || !changeAllowed}}">改期</button><button class="danger" bindtap="toggleCancel" disabled="{{loading || busy || pending || !changeAllowed}}">{{cancelling ? '暂不取消' : '取消预约'}}</button></view>
      <view wx:if="{{cancelling}}" class="space"><text class="label">取消原因 *</text><textarea class="textarea" value="{{reason}}" bindinput="reasonInput" maxlength="500" placeholder="请简要说明取消原因" /><button class="danger space" bindtap="cancel" loading="{{busy}}" disabled="{{loading || busy || pending || !changeAllowed || !reason}}">确认取消</button></view><view wx:if="{{appointment.cancellationReason}}" class="muted space">变更原因：{{appointment.cancellationReason}}</view>
      <view wx:if="{{appointment.supersedesAppointmentId}}" class="link space" data-id="{{appointment.supersedesAppointmentId}}" bindtap="related">查看原预约 →</view><view wx:if="{{appointment.replacementAppointmentId}}" class="link space" data-id="{{appointment.replacementAppointmentId}}" bindtap="related">查看新预约 →</view>
    </view>
    <view wx:if="{{appointment.status === 'confirmed'}}" class="card"><view class="section-title">下次就诊</view><view class="muted">按医生建议安排复诊，沿用本次门诊、医生和项目，也可自行调整。</view><button class="primary space" bindtap="followup" disabled="{{loading || busy || pending}}">复诊预约</button></view>
    <view wx:if="{{events.length}}" class="card"><view class="section-title">预约动态</view><view wx:for="{{events}}" wx:key="id" class="event"><view class="event-dot"></view><view class="grow"><view>{{item.label}}</view><view class="muted small">{{item.dateLabel}} · {{item.actorName}}</view><view wx:if="{{item.reason}}" class="small">{{item.reason}}</view></view></view></view>
    <button class="secondary" bindtap="appointments">返回我的预约</button>
  </block>
</view>
