<view class="page"><view wx:if="{{success && appointment.status === 'confirmed'}}" class="success-banner"><view class="success-symbol">✓</view><view class="title">预约已确认</view><view class="muted">期待与你相见。请按预约时间到诊。</view></view>
  <view wx:if="{{loading && !appointment}}" class="loading">正在读取预约详情…</view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary space" bindtap="load" disabled="{{loading}}">重新读取</button></view>
  <view wx:if="{{pending}}" class="notice"><view class="section-title">操作结果待确认</view><view>原操作标识与内容已保留，不会自动重复提交。</view><view class="buttons space"><button class="secondary" bindtap="inspect" disabled="{{busy}}">核对结果</button><button class="secondary" bindtap="retry" disabled="{{busy}}">重试原操作</button></view></view>
  <block wx:if="{{appointment}}"><view class="card"><view class="row"><view class="eyebrow">APPOINTMENT</view><text class="badge {{appointment.status}}">{{appointment.statusLabel}}</text></view><view class="section-title space">{{appointment.serviceName}}</view><view class="detail-time">{{appointment.dateLabel}}<view class="muted">至 {{appointment.endLabel}} · 北京时间</view></view><view class="divider"></view><view class="detail-label">就诊门诊</view><view class="detail-value">{{appointment.clinicName}}</view><view class="muted small">{{appointment.clinicAddress}}</view><view class="row space"><view><view class="detail-label">接诊医生</view><view class="detail-value">{{appointment.doctorName}}</view><text wx:if="{{appointment.doctorIsDemo}}" class="demo-badge space">虚构医生</text></view><view><view class="detail-label">实际就诊人</view><view class="detail-value">{{appointment.patientName}}</view><text wx:if="{{appointment.patientIsDemo}}" class="demo-badge space">虚构患者</text></view></view><view class="divider"></view><view class="detail-label">唯一预约编号</view><view class="number">{{appointment.appointmentNo}}</view><view class="notice space">请按预约安排到诊；是否已到诊与诊疗进展，请与门诊确认。</view></view>
    <view class="card"><view class="section-title">取消与改期</view><view class="muted">需提前 {{appointment.policy.cancellationNoticeMinutes}} 分钟。取消后释放资源，原记录与原因保留；改期成功后新旧预约可追溯。</view><view wx:if="{{appointment.status === 'confirmed' && !changeAllowed}}" class="notice space">已接近或超过自助变更截止时间，请联系门诊协调。请按门诊公布的预约规则办理。</view><view wx:if="{{appointment.status === 'confirmed'}}" class="buttons space"><button class="secondary" bindtap="reschedule" disabled="{{busy || pending || !changeAllowed}}">修改时间</button><button class="danger" bindtap="toggleCancel" disabled="{{busy || pending || !changeAllowed}}">{{cancelling ? '暂不取消' : '取消预约'}}</button></view>
      <view wx:if="{{cancelling}}" class="space"><text class="label">取消原因 *</text><textarea class="textarea" value="{{reason}}" bindinput="reasonInput" maxlength="500" placeholder="请简要说明取消原因" /><button class="danger space" bindtap="cancel" loading="{{busy}}" disabled="{{busy || pending || !reason}}">确认取消并释放时段</button></view><view wx:if="{{appointment.cancellationReason}}" class="muted space">变更原因：{{appointment.cancellationReason}}</view>
      <view wx:if="{{appointment.supersedesAppointmentId}}" class="link space" data-id="{{appointment.supersedesAppointmentId}}" bindtap="related">查看改期前的原预约 →</view><view wx:if="{{appointment.replacementAppointmentId}}" class="link space" data-id="{{appointment.replacementAppointmentId}}" bindtap="related">查看改期后的新预约 →</view>
    </view>
    <view wx:if="{{events.length}}" class="card"><view class="section-title">预约动态</view><view wx:for="{{events}}" wx:key="id" class="event"><view class="event-dot"></view><view class="grow"><view>{{item.label}}</view><view class="muted small">{{item.dateLabel}} · {{item.actorName}}</view><view wx:if="{{item.reason}}" class="small">{{item.reason}}</view></view></view></view>
    <button class="secondary" bindtap="appointments">返回我的预约</button>
  </block>
</view>
