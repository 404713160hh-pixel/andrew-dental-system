 .success-banner{text-align:center;padding:36rpx 28rpx;margin-bottom:28rpx;background:#fcfbf9;border:1rpx solid #eae7e1;border-radius:16rpx}.success-symbol{width:90rpx;height:90rpx;line-height:90rpx;border:1rpx solid #b79a6b;border-radius:50%;color:#9e8257;font-size:50rpx;margin:0 auto 18rpx}.success-banner .title{font-size:40rpx}.detail-time{font-size:34rpx;font-weight:600;line-height:1.6;margin-top:16rpx;word-break:break-word}.detail-time .muted{font-size:24rpx;font-weight:400}.number{font-size:27rpx;line-height:1.75;letter-spacing:1rpx;font-weight:600;margin-top:10rpx;word-break:break-all}.event{display:flex;gap:20rpx;line-height:1.85;margin:28rpx 0}.event-dot{background:#b79a6b;width:13rpx;height:13rpx;border-radius:50%;margin-top:15rpx;flex-shrink:0}

.detail-page .card>.row{align-items:flex-start;gap:24rpx}.detail-page .card>.row>view{flex:1;min-width:0}.detail-page .detail-value{line-height:1.75;word-break:break-word}.detail-page .card>.muted{line-height:1.85}.detail-page .card>.section-title.space{margin-top:24rpx;margin-bottom:18rpx}.detail-page .event .small{line-height:1.8}
