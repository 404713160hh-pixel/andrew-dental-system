 .success-banner{text-align:center;padding:32rpx 22rpx;margin-bottom:25rpx;background:#fcfbf9;border:1rpx solid #eae7e1}.success-symbol{width:90rpx;height:90rpx;line-height:90rpx;border:1rpx solid #b79a6b;border-radius:50%;color:#9e8257;font-size:50rpx;margin:0 auto 18rpx}.success-banner .title{font-size:40rpx}.detail-time{font-size:38rpx;font-weight:600;margin-top:14rpx}.detail-time .muted{font-size:24rpx;font-weight:400}.number{font-size:30rpx;letter-spacing:1rpx;font-weight:600;margin-top:8rpx}.event{display:flex;gap:20rpx;margin:25rpx 0}.event-dot{background:#b79a6b;width:13rpx;height:13rpx;border-radius:50%;margin-top:15rpx;flex-shrink:0}
