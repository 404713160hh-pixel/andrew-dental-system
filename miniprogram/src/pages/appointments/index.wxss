.appointment-heading{margin-bottom:28rpx}
.appointment-heading .row{align-items:center;gap:20rpx}
.appointment-heading .title{font-size:38rpx;line-height:1.45;margin:0}
.appointment-heading .inline-button{flex-shrink:0;min-height:66rpx;padding:12rpx 18rpx;font-size:23rpx}
.intro{margin-bottom:32rpx}.appointment-heading .intro{margin-bottom:0}
.appointments-guest{padding:44rpx 36rpx;text-align:left;background:#fff}
.empty-title{font-size:30rpx;font-weight:600;color:#1d4ed8;line-height:1.5;margin-bottom:14rpx}
.empty-copy{font-size:25rpx;line-height:1.8}
.appointments-guest .primary{margin-top:32rpx;width:100%}
.list-tools{margin-bottom:24rpx;border-top:1rpx solid #e5eaf2;padding-top:22rpx}
.appointment-card{position:relative;transition:transform .2s,opacity .2s}
.clinic-name{font-size:27rpx;font-weight:600;min-width:0;flex:1;line-height:1.6}
.time-label{font-family:Georgia,"Songti SC",serif;font-size:33rpx;font-weight:600;margin:26rpx 0 17rpx;color:#111827;line-height:1.6}
.time-label text{font-family:-apple-system,sans-serif;font-size:24rpx;color:#64748b;font-weight:400}
.service-name{font-size:29rpx;font-weight:600;margin-bottom:8rpx;line-height:1.6}
.list-tools .pill{background:#f8fafc;border:1rpx solid #e5eaf2;color:#475569}
@media(max-width:350px){.appointments-guest{padding:36rpx 30rpx}.appointment-heading .title{font-size:36rpx}.appointment-heading .inline-button{font-size:22rpx;padding:10rpx 14rpx}.time-label{font-size:30rpx}}

.appointments-page .list-kicker{font-size:21rpx;color:#2563eb;font-weight:600;letter-spacing:1rpx}
.appointments-page .appointment-heading .row>view{min-width:0}
.appointments-page .appointment-card{border-color:#e5eaf2;box-shadow:0 6rpx 22rpx rgba(37,99,235,.04)}
.appointments-page .time-label{font-family:inherit;color:#111827}
.appointments-page .list-tools .pill{background:#eff6ff;border-color:#e5eaf2;color:#1d4ed8}
