<view class="page appointments-page"><view class="appointment-heading"><view class="row"><view class="title">我的预约</view><button class="secondary inline-button" bindtap="book" disabled="{{!signedIn}}">＋ 新预约</button></view></view>
  <view wx:if="{{!signedIn}}" class="empty appointments-guest"><view class="empty-title">登录后查看预约</view><button class="primary space" bindtap="login">登录 / 注册</button></view>
  <block wx:if="{{signedIn}}"><view wx:if="{{pending}}" class="notice"><view class="section-title">提交结果待确认</view><view>请先核对结果，再重试原操作。</view><view class="buttons space"><button class="secondary" disabled="{{busy}}" bindtap="inspect">核对结果</button><button class="secondary" disabled="{{busy}}" bindtap="retry">重试原操作</button></view></view>
    <view class="row list-tools"><text class="muted">共 {{total}} 条记录</text><picker range="{{filterNames}}" value="{{filterIndex}}" bindchange="filter" disabled="{{loading}}"><view class="pill">{{filterNames[filterIndex]}} ▾</view></picker></view>
    <view wx:if="{{error}}" class="error">{{error}}<button class="secondary space" bindtap="refresh">重新加载</button></view><view wx:if="{{loading && !items.length}}" class="loading">加载中…</view>
    <view wx:for="{{items}}" wx:key="id" class="card appointment-card" hover-class="card-pressed" data-id="{{item.id}}" bindtap="detail"><view class="row"><text class="clinic-name">{{item.clinicName}}</text><text class="badge {{item.status}}">{{item.statusLabel}}</text></view><view class="time-label">{{item.dateLabel}}<text>—{{item.endLabel}}</text></view><view class="service-name">{{item.serviceName}}</view><view class="muted">{{item.doctorName}} · 就诊人 {{item.patientName}}</view><view wx:if="{{item.doctorIsDemo || item.patientIsDemo}}" class="demo-label-row space"><text wx:if="{{item.doctorIsDemo}}" class="demo-badge">虚构医生</text><text wx:if="{{item.patientIsDemo}}" class="demo-badge">虚构患者</text></view><view class="divider"></view><view class="row"><text class="small muted">{{item.appointmentNo}}</text><text class="link small">查看详情 →</text></view></view>
    <view wx:if="{{!loading && !error && !items.length}}" class="empty">暂无符合条件的预约。<button class="secondary space" bindtap="book">预约就诊</button></view><button wx:if="{{hasMore}}" class="secondary" loading="{{loading}}" disabled="{{loading}}" bindtap="more">加载更多</button><view wx:if="{{!hasMore && items.length}}" class="footer-note">已显示全部记录</view>
  </block>
</view>
