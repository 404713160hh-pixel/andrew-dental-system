<view class="page"><view class="eyebrow">YOUR CARE SCHEDULE</view><view class="row"><view class="title">我的预约</view><button class="secondary inline-button" bindtap="book">＋ 新预约</button></view><view class="muted intro">预约安排、取消和改期记录都保留在这里。</view>
  <view wx:if="{{!signedIn}}" class="empty">登录后查看账号本人的预约。<button class="primary space" bindtap="login">登录 / 注册</button></view>
  <block wx:if="{{signedIn}}"><view wx:if="{{pending}}" class="notice"><view class="section-title">有一笔提交结果待确认</view><view>已保留原操作，不会自动重复占号。请核对结果，或以同一操作标识重试。</view><view class="buttons space"><button class="secondary" disabled="{{busy}}" bindtap="inspect">核对结果</button><button class="secondary" disabled="{{busy}}" bindtap="retry">重试原操作</button></view></view>
    <view class="row list-tools"><text class="muted">共 {{total}} 条记录</text><picker range="{{filterNames}}" value="{{filterIndex}}" bindchange="filter" disabled="{{loading}}"><view class="pill">{{filterNames[filterIndex]}} ▾</view></picker></view>
    <view wx:if="{{error}}" class="error">{{error}}<button class="secondary space" bindtap="refresh">重新读取预约</button></view><view wx:if="{{loading && !items.length}}" class="loading">正在读取你的预约…</view>
    <view wx:for="{{items}}" wx:key="id" class="card appointment-card" data-id="{{item.id}}" bindtap="detail"><view class="row"><text class="clinic-name">{{item.clinicName}}</text><text class="badge {{item.status}}">{{item.statusLabel}}</text></view><view class="time-label">{{item.dateLabel}}<text>—{{item.endLabel}}</text></view><view class="service-name">{{item.serviceName}}</view><view class="muted">{{item.doctorName}} · 就诊人 {{item.patientName}}</view><view class="divider"></view><view class="row"><text class="small muted">{{item.appointmentNo}}</text><text class="link small">查看详情 →</text></view></view>
    <view wx:if="{{!loading && !error && !items.length}}" class="empty">暂无符合条件的预约。<button class="secondary space" bindtap="book">挑选一个就诊时间</button></view><button wx:if="{{hasMore}}" class="secondary" loading="{{loading}}" disabled="{{loading}}" bindtap="more">加载更多</button><view wx:if="{{!hasMore && items.length}}" class="footer-note">已显示全部记录</view>
  </block>
</view>
