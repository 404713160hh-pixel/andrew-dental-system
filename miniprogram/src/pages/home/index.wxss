.brand{margin:5rpx 0 32rpx}.brand-symbol{background:#087d87;color:white;width:70rpx;height:70rpx;border-radius:21rpx;font-size:44rpx;font-weight:700;text-align:center;line-height:70rpx;position:relative}.brand-symbol text{position:absolute;font-size:23rpx;right:5rpx;top:-17rpx}.brand-name{font-size:30rpx;font-weight:700}.brand .eyebrow{font-size:16rpx;letter-spacing:2rpx}.hero{position:relative;overflow:hidden;border-radius:36rpx;background:linear-gradient(125deg,#dcf2f1,#eaf3fb);padding:44rpx 36rpx;margin-bottom:26rpx;min-height:530rpx}.hero-title{font-size:55rpx;font-weight:750;line-height:1.4;letter-spacing:1rpx;margin:14rpx 0 18rpx;position:relative}.hero-description{color:#577583;font-size:27rpx;position:relative}.hero-button{margin-top:32rpx;width:300rpx;position:relative;text-align:left;display:flex;justify-content:space-between}.hero-note{font-size:21rpx;color:#6a9195;margin-top:18rpx}.hero-art{position:absolute;right:-90rpx;top:30rpx;width:350rpx;height:450rpx;transform:rotate(-12deg)}.hero-art view{position:absolute;width:220rpx;height:340rpx;border:24rpx solid rgba(255,255,255,.5);border-radius:120rpx;top:50rpx}.hero-art view:nth-child(2){left:100rpx;top:120rpx;border-color:rgba(255,255,255,.7)}.hero-art text{color:#8cc4ce;font-size:130rpx;position:absolute;right:50rpx;top:10rpx}.shortcuts .card{padding:25rpx}.shortcuts .section-title{font-size:29rpx;margin:13rpx 0 6rpx}.shortcut-icon{font-size:42rpx;color:#0b858d;line-height:1}.clinic-mark{background:#edf8f5;color:#20958a;width:82rpx;height:82rpx;border-radius:22rpx;text-align:center;line-height:82rpx;font-size:48rpx}.clinic-card .section-title{font-size:30rpx;margin:0 0 7rpx}.phone{color:#71919c;margin-top:9rpx}.intro{margin:-6rpx 0 24rpx}.service-meta{font-size:23rpx;margin-top:14rpx;color:#318290}
