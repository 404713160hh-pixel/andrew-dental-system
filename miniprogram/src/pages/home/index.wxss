 .home-page{padding-top:28rpx}.brand{padding:6rpx 0 42rpx;align-items:center}.brand-identity{min-width:0}.brand-name{font-family:Georgia,serif;font-size:29rpx;font-weight:600;letter-spacing:3rpx;line-height:1.25;white-space:nowrap}.brand-name text{font-weight:400}.brand-sub{font-size:18rpx;color:#77746f;letter-spacing:3rpx;margin-top:5rpx}.account-link{font-size:23rpx;color:#5d5b56;max-width:235rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.account-link text{color:#9e8257;margin-left:8rpx}
.hero{padding-bottom:16rpx}.hero-title{font-family:"Noto Serif SC","Songti SC",serif;font-size:58rpx;line-height:1.4;color:#252522;margin:20rpx 0 16rpx;font-weight:600}.hero-description{font-size:26rpx;line-height:1.9;color:#77746f}.hero-actions{display:flex;align-items:center;gap:35rpx;margin:30rpx 0 38rpx}.hero-button{margin:0;padding:19rpx 27rpx;width:265rpx;font-size:26rpx;text-align:left}.hero-button text{float:right}.hero-secondary{font-size:25rpx;color:#4e4b46}.hero-secondary text{color:#9e8257}.hero-image{width:100%;height:360rpx;display:block;border-radius:5rpx;background:#f7f5f1}.image-caption{display:flex;justify-content:space-between;font-size:18rpx;letter-spacing:2rpx;color:#8e8980;margin-top:12rpx}.image-caption text{letter-spacing:0}.demo-home-notice{display:flex;gap:12rpx;align-items:flex-start;padding:18rpx 0;font-size:22rpx;color:#77746f}.demo-home-notice .demo-badge{flex-shrink:0}
.home-shortcuts{display:grid;grid-template-columns:repeat(4,1fr);border-top:1rpx solid #eae7e1;border-bottom:1rpx solid #eae7e1;margin:25rpx 0 57rpx}.home-shortcuts>view{padding:24rpx 7rpx 26rpx;border-right:1rpx solid #eae7e1;transition:opacity .2s ease}.home-shortcuts>view:last-child{border:0}.shortcut-number,.shortcut-title,.shortcut-more{display:block}.shortcut-number{font-family:Georgia,serif;color:#a68b62;font-size:20rpx}.shortcut-title{font-size:23rpx;color:#292d30;font-weight:600;margin-top:8rpx;white-space:nowrap}.shortcut-more{font-size:19rpx;color:#77746f;margin-top:8rpx;white-space:nowrap}.shortcut-pressed{opacity:.55}
.home-section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:15rpx;margin:52rpx 0 24rpx}.section-kicker{font-size:19rpx;letter-spacing:2rpx;color:#947a55;margin-bottom:9rpx}.home-section-heading .section-title{font-size:35rpx;margin:0}.home-section-heading>.small{font-size:21rpx;white-space:nowrap}.section-link{font-size:23rpx;color:#826a48;white-space:nowrap}
.clinic-card{display:flex;gap:24rpx;padding:25rpx 0;border-bottom:1rpx solid #eae7e1}.clinic-number{font-family:Georgia,serif;font-size:26rpx;color:#aa9370}.clinic-name{font-family:"Noto Serif SC","Songti SC",serif;font-size:30rpx;font-weight:600}.clinic-address,.clinic-phone{font-size:23rpx;color:#77746f;line-height:1.9;margin-top:5rpx}.clinic-actions{display:flex;gap:30rpx;font-size:23rpx;color:#826a48;margin-top:20rpx}
.home-doctor-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15rpx}.home-doctor-card{min-width:0;transition:transform .2s,opacity .2s}.home-portrait{height:200rpx;position:relative;overflow:hidden;background:#f7f5f1}.home-portrait image{width:100%;height:100%;display:block}.home-portrait>text{position:absolute;right:6rpx;bottom:6rpx;color:#51483d;font-size:17rpx;background:#fff;padding:3rpx 7rpx}.home-doctor-name{font-size:25rpx;font-weight:600;margin-top:13rpx}.home-doctor-specialty{font-size:20rpx;color:#77746f;line-height:1.6;margin:5rpx 0 10rpx;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;min-height:62rpx}.home-doctor-card .demo-badge{font-size:18rpx}
.service-intro{line-height:1.9;margin:0 0 20rpx}.home-service{display:flex;align-items:center;gap:20rpx;padding:26rpx 0;border-bottom:1rpx solid #eae7e1;transition:opacity .2s}.service-name{font-family:"Noto Serif SC","Songti SC",serif;font-size:29rpx;font-weight:600}.service-description{font-size:23rpx;line-height:1.8;color:#77746f;margin-top:8rpx}.service-meta{font-size:21rpx;color:#8b7352;margin-top:10rpx}.service-arrow{font-size:30rpx;color:#a68b62}.reference-entry{margin-top:35rpx;padding:25rpx;background:#fcfbf9;border:1rpx solid #eae7e1;display:flex;align-items:center;gap:20rpx}.reference-entry-title{font-family:"Noto Serif SC","Songti SC",serif;font-size:27rpx;font-weight:600}.reference-entry-source{font-size:21rpx;color:#77746f;margin-top:8rpx}.reference-entry>text{color:#a68b62}.care-strip{padding:48rpx 0 12rpx}.care-title{font-family:"Noto Serif SC","Songti SC",serif;font-size:35rpx;line-height:1.4;margin:14rpx 0}.care-strip .primary{width:100%;margin-top:25rpx}.home-page>.footer-note{border-top:1rpx solid #eae7e1;padding-top:25rpx;margin-top:35rpx}
@media(max-width:350px){.hero-title{font-size:49rpx}.shortcut-title{font-size:21rpx}.shortcut-more{font-size:17rpx}.home-portrait{height:170rpx}}

.service-scene{margin:26rpx 0 10rpx}.service-scene image{width:100%;height:270rpx;display:block;border-radius:5rpx;background:#f7f5f1}.service-scene>view{display:flex;justify-content:space-between;gap:12rpx;margin-top:11rpx;color:#77746f;font-size:18rpx;letter-spacing:2rpx}.service-scene text{letter-spacing:0}

/* Eight fictional portraits share a compact image sheet; each card reveals one cell. */
.home-portrait image.doctor-sprite{position:absolute;width:400%;height:200%;max-width:none}
.clinic-card{flex-wrap:wrap}.clinic-visual{position:relative;width:100%;height:260rpx;overflow:hidden;background:#f1eee8}.clinic-visual image{width:100%;height:100%;display:block}.clinic-visual text{position:absolute;right:8rpx;bottom:8rpx;background:#fff;color:#625b50;font-size:19rpx;padding:4rpx 8rpx}.clinic-hours,.clinic-description{font-size:23rpx;color:#77746f;line-height:1.8;margin-top:6rpx}
