.home-page{padding-top:24rpx}
.home-banner{position:relative;height:280rpx;overflow:hidden;border-radius:24rpx;background:#e4e9e6}
.banner-image{display:block;width:100%;height:100%}
.banner-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(30,49,49,.45),rgba(30,49,49,0) 80%)}
.banner-title{position:absolute;left:32rpx;bottom:38rpx;color:#fff;font-size:44rpx;font-weight:600;letter-spacing:3rpx}
.banner-caption{position:absolute;right:18rpx;bottom:16rpx;color:#fff;font-size:18rpx;background:rgba(30,49,49,.35);padding:3rpx 10rpx;border-radius:6rpx}
.entry-panel{position:relative;margin-top:24rpx;padding:24rpx;background:#fff;border-radius:24rpx;border:1rpx solid #eae7e1}
.primary-entries{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx}
.feature-entry{display:flex;align-items:center;gap:16rpx;min-width:0;min-height:158rpx;padding:24rpx 18rpx;border-radius:18rpx}
.booking-entry{background:linear-gradient(135deg,#edf6fa,#dceff2)}
.clinic-entry{background:linear-gradient(135deg,#f5f3e8,#f0ebdc)}
.feature-icon{width:62rpx;height:62rpx;flex-shrink:0;opacity:.8}
.feature-title{font-size:29rpx;font-weight:600;line-height:1.5;white-space:nowrap}
.feature-subtitle{font-size:21rpx;color:#717975;margin-top:8rpx;line-height:1.6;white-space:nowrap}
.home-shortcuts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12rpx;padding-top:30rpx}
.home-shortcuts>view{display:flex;flex-direction:column;align-items:center;gap:12rpx;min-width:0;padding:8rpx 0}
.home-shortcuts>view>text{font-size:23rpx;color:#414c4b;line-height:1.5;white-space:nowrap}
.shortcut-icon{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;border-radius:24rpx}
.shortcut-icon image{width:46rpx;height:46rpx;opacity:.8}
.team-icon{background:#e8f2f4}.project-icon{background:#f6eedf}.appointment-icon{background:#edf0f8}.profile-icon{background:#eaf2eb}
.demo-home-notice{font-size:21rpx;color:#8b8171;padding:18rpx 6rpx 0;line-height:1.7}
.home-section{margin-top:24rpx;padding:28rpx;background:#fff;border:1rpx solid #eae7e1;border-radius:24rpx}
.home-section-heading{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-bottom:24rpx}
.home-section-heading .section-title{font-family:inherit;font-size:31rpx;line-height:1.5;margin:0}
.section-link{font-size:22rpx;color:#77746f;white-space:nowrap;padding:8rpx 0}
.home-doctor-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18rpx}
.home-doctor-card{min-width:0}
.home-portrait{width:100%;aspect-ratio:1;position:relative;overflow:hidden;background:#f3f0ea;border-radius:14rpx}
.home-portrait image.doctor-sprite{position:absolute;width:400%;height:200%;max-width:none}
.home-portrait>text{position:absolute;right:6rpx;bottom:6rpx;border-radius:4rpx;color:#625b50;font-size:17rpx;background:rgba(255,255,255,.94);padding:2rpx 7rpx}
.portrait-initial{display:flex;align-items:center;justify-content:center;height:100%;font-size:42rpx;color:#8b8171}
.home-doctor-name{font-size:26rpx;font-weight:600;line-height:1.5;margin-top:14rpx}
.home-doctor-specialty{font-size:21rpx;color:#77746f;line-height:1.6;margin-top:6rpx;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}
.home-service{display:flex;align-items:center;gap:18rpx;padding:22rpx 0;border-top:1rpx solid #efede8}
.home-service:first-of-type{border-top:0}
.service-name{font-size:27rpx;font-weight:500;line-height:1.6}
.service-meta{font-size:21rpx;color:#77746f;line-height:1.7;margin-top:6rpx}
.service-arrow{font-size:34rpx;color:#a29a8a;flex-shrink:0}
.home-empty{font-size:25rpx;color:#77746f;text-align:center;padding:24rpx 0}
@media(max-width:350px){.entry-panel{padding:20rpx}.primary-entries{gap:14rpx}.feature-entry{padding:24rpx 14rpx;gap:10rpx}.feature-icon{width:52rpx;height:52rpx}.feature-title{font-size:27rpx}.feature-subtitle{font-size:20rpx}.home-section{padding:24rpx}.home-shortcuts>view>text{font-size:22rpx}}
