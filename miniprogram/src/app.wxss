/* Shared healthcare palette and controls; page-specific classes remain compatible. */
page{--ink:#111827;--muted:#64748b;--subtle:#94a3b8;--line:#e5eaf2;--paper:#f5f8ff;--warm:#f8fafc;--surface:#fff;--accent:#2563eb;--dark:#1d4ed8;--primary:#2563eb;--primary-pressed:#1d4ed8;--primary-light:#eff6ff;--primary-soft:#e8f1ff;--disabled:#cbd5e1;--success:#16a34a;--success-light:#ecfdf3;--warning:#d97706;--warning-light:#fff7ed;--error:#dc2626;--error-light:#fef2f2;--info:#2563eb;--info-light:#eff6ff;background:#f5f8ff;color:#111827;font-family:"PingFang SC","HarmonyOS Sans SC",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx;line-height:1.6}
view,text,input,textarea,button{box-sizing:border-box}
.page{padding:40rpx 32rpx 48rpx;padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}
.card{background:#fff;border:1rpx solid #e5eaf2;border-radius:20rpx;padding:32rpx;margin-bottom:24rpx}
.eyebrow{font-size:20rpx;letter-spacing:2rpx;color:#2563eb;font-weight:600}
.title{font-family:inherit;font-size:44rpx;font-weight:700;line-height:1.4;margin:12rpx 0 16rpx;color:#111827}
.section-title{font-family:inherit;font-size:32rpx;font-weight:600;margin:8rpx 0 16rpx;color:#111827}
.muted{color:#64748b;font-size:25rpx;line-height:1.8}.small{font-size:23rpx}
.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.stack{display:flex;flex-direction:column;gap:8rpx}.grow{flex:1;min-width:0}.space{margin-top:24rpx}
.primary,.secondary,.danger{border-radius:16rpx;font-size:28rpx;font-weight:600;line-height:1.5;padding:24rpx;margin:0;transition:opacity .2s ease,transform .2s ease,background-color .2s ease}
.primary{background:#2563eb;color:#fff}.secondary{background:#eff6ff;color:#1d4ed8;border:1rpx solid #e5eaf2}.danger{background:#fef2f2;color:#dc2626;border:1rpx solid #fecaca}
.primary.space,.secondary.space,.danger.space{margin-top:24rpx}
.card>.section-title:first-child{margin-top:0}.card>.muted+.primary{margin-top:24rpx}
.primary::after,.secondary::after,.danger::after{border:0}.primary.button-hover{background:#1d4ed8;color:#fff;transform:scale(.985)}.secondary.button-hover,.danger.button-hover{opacity:.8;transform:scale(.985)}button[disabled]{background:#e5eaf2!important;color:#64748b!important;border-color:#cbd5e1!important;box-shadow:none!important;opacity:1!important}
.link{color:#2563eb;font-weight:600}.label{font-size:25rpx;font-weight:600;display:block;margin:24rpx 0 8rpx}
.input,.picker,.textarea{background:#fff;border:1rpx solid #e5eaf2;border-radius:12rpx;padding:16rpx 24rpx;width:100%;font-size:27rpx;min-height:88rpx;color:#111827}.input:focus,.textarea:focus{border-color:#2563eb}.textarea{height:160rpx}
.error,.notice,.success{border-radius:12rpx;padding:24rpx;margin-bottom:24rpx;font-size:25rpx;line-height:1.8}.error{background:#fef2f2;color:#b91c1c;border-left:4rpx solid #dc2626}.notice{background:#fff7ed;color:#92400e;border-left:4rpx solid #d97706}.success{background:#ecfdf3;color:#166534;border-left:4rpx solid #16a34a}
.empty{text-align:center;padding:48rpx 32rpx;background:#fff;border:1rpx solid #eef2f7;border-radius:20rpx;color:#64748b;line-height:1.8}
.badge{display:inline-block;border-radius:8rpx;padding:4rpx 12rpx;background:#eff6ff;color:#1d4ed8;font-size:22rpx;white-space:nowrap}.badge.cancelled{background:#f8fafc;color:#64748b}.badge.rescheduled{background:#fff7ed;color:#92400e}
.divider{height:1rpx;background:#eef2f7;margin:24rpx 0}.detail-label{color:#64748b;font-size:24rpx}.detail-value{font-size:28rpx;margin-top:8rpx;word-break:break-all}
.buttons{display:flex;gap:16rpx}.buttons button{flex:1;min-width:0}.loading{padding:32rpx;text-align:center;color:#64748b}.step{display:flex;gap:12rpx;color:#64748b;font-size:23rpx;margin-bottom:24rpx}.step .active{color:#2563eb;font-weight:650}.checkline{display:flex;align-items:flex-start;gap:12rpx;font-size:25rpx;margin:24rpx 0}.checkline checkbox{transform:scale(.8);margin-left:-7rpx}
.inline-button{padding:12rpx 16rpx;font-size:24rpx}.skeleton{height:100rpx;background:#eef2f7;border-radius:12rpx;margin-bottom:16rpx}.footer-note{font-size:22rpx;color:#64748b;text-align:center;margin-top:32rpx;line-height:1.8}.pill{padding:12rpx 16rpx;border-radius:12rpx;background:#f8fafc;color:#475569;font-size:23rpx}.selected{border-color:#2563eb!important;background:#eff6ff!important}.nav-card{margin-top:24rpx}.two-columns{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}
.demo-badge{display:inline-block;white-space:nowrap;border-radius:8rpx;padding:4rpx 8rpx;font-size:20rpx;font-weight:500;line-height:1.6;background:#fff7ed;color:#92400e;border:1rpx solid #fed7aa}.demo-note{padding:16rpx 24rpx;border-radius:12rpx;background:#f8fafc;border:1rpx solid #e5eaf2;color:#475569;font-size:23rpx;line-height:1.9}.demo-label-row{display:flex;align-items:center;gap:12rpx;flex-wrap:wrap}.demo-note.space{margin-top:24rpx}.fee-explanation{font-size:23rpx;color:#64748b;line-height:1.9;margin-top:16rpx;padding-top:16rpx;border-top:1rpx solid #eef2f7}
.card-pressed{opacity:.82;transform:scale(.99)}.tap-soft{opacity:.7}
@media(max-width:350px){.page{padding-left:24rpx;padding-right:24rpx}.step{font-size:21rpx;gap:8rpx}.row{gap:12rpx}.two-columns{gap:12rpx}.title{font-size:40rpx}}
