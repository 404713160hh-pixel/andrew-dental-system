page{background:#f6f8fb;color:#183446;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx;line-height:1.6}view,text,input,textarea,button{box-sizing:border-box}.page{padding:32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom))}.card{background:#fff;border:1rpx solid #e4edf0;border-radius:28rpx;padding:30rpx;margin-bottom:24rpx;box-shadow:0 8rpx 28rpx rgba(18,69,84,.035)}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#338a95;font-weight:600}.title{font-size:42rpx;font-weight:700;line-height:1.35;margin:12rpx 0 18rpx}.section-title{font-size:32rpx;font-weight:650;margin:8rpx 0 18rpx}.muted{color:#718491;font-size:25rpx}.small{font-size:23rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.stack{display:flex;flex-direction:column;gap:8rpx}.grow{flex:1;min-width:0}.space{margin-top:24rpx}.primary,.secondary,.danger{border-radius:18rpx;font-size:28rpx;font-weight:600;line-height:1.5;padding:22rpx 24rpx;margin:0}.primary{background:#0b858d;color:#fff}.primary::after,.secondary::after,.danger::after{border:0}.secondary{background:#edf6f8;color:#176b7b}.danger{background:#fff0ed;color:#a04438}button[disabled]{background:#e6edef!important;color:#92a1a9!important}.link{color:#087d87;font-weight:600}.label{font-size:25rpx;font-weight:600;display:block;margin:22rpx 0 10rpx}.input,.picker,.textarea{background:#f6f9fa;border:1rpx solid #dfe8ec;border-radius:16rpx;padding:19rpx 22rpx;width:100%;font-size:27rpx;min-height:82rpx}.textarea{height:156rpx}.error,.notice,.success{border-radius:18rpx;padding:22rpx 24rpx;margin-bottom:24rpx;font-size:25rpx}.error{background:#fff1ed;color:#9b4134}.notice{background:#edf5fb;color:#416478}.success{background:#e9f7f2;color:#23765e}.empty{text-align:center;padding:70rpx 25rpx;background:#fff;border:1rpx dashed #d6e6e9;border-radius:26rpx;color:#748793}.badge{display:inline-block;border-radius:12rpx;padding:5rpx 14rpx;background:#e4f5f0;color:#217d68;font-size:22rpx;white-space:nowrap}.badge.cancelled{background:#f0f2f4;color:#7b8892}.badge.rescheduled{background:#eaf1fb;color:#5178a2}.divider{height:1rpx;background:#edf1f3;margin:22rpx 0}.detail-label{color:#7a8c97;font-size:24rpx}.detail-value{font-size:28rpx;margin-top:5rpx;word-break:break-all}.buttons{display:flex;gap:16rpx}.buttons button{flex:1}.loading{padding:32rpx;text-align:center;color:#558692}.step{display:flex;gap:12rpx;color:#90a3ae;font-size:23rpx;margin-bottom:24rpx}.step .active{color:#087d87;font-weight:650}.checkline{display:flex;align-items:flex-start;gap:12rpx;font-size:25rpx;margin:22rpx 0}.checkline checkbox{transform:scale(.8);margin-left:-7rpx}.inline-button{padding:8rpx 16rpx;font-size:24rpx}.skeleton{height:100rpx;background:linear-gradient(90deg,#f0f5f7,#fff,#f0f5f7);border-radius:20rpx;margin-bottom:18rpx}.footer-note{font-size:22rpx;color:#91a0a9;text-align:center;margin-top:30rpx}.pill{padding:10rpx 18rpx;border-radius:30rpx;background:#edf6f7;color:#37747c;font-size:23rpx}.selected{border-color:#0b858d!important;background:#effaf8!important}.nav-card{margin-top:20rpx}.two-columns{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}
.demo-badge{display:inline-block;white-space:nowrap;border-radius:9rpx;padding:4rpx 10rpx;font-size:20rpx;font-weight:500;line-height:1.6;background:#f7edda;color:#9c8356;border:1rpx solid #eddfc2}.demo-note{padding:18rpx 21rpx;border-radius:15rpx;background:#fbf7ef;border:1rpx solid #eee4d2;color:#a18c6b;font-size:23rpx;line-height:1.9}.demo-label-row{display:flex;align-items:center;gap:12rpx;flex-wrap:wrap}.demo-note.space{margin-top:20rpx}.fee-explanation{font-size:23rpx;color:#8b9fa8;line-height:1.9;margin-top:17rpx;padding-top:17rpx;border-top:1rpx dashed #dfebee}@media(max-width:350px){.page{padding-left:26rpx;padding-right:26rpx}.step{font-size:21rpx;gap:8rpx}.row{gap:12rpx}.two-columns{gap:13rpx}.demo-badge{font-size:21rpx}.title{font-size:40rpx}}
