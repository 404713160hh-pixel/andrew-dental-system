.profile-form {
  color: #183446;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.profile-form,
.notice,
.label,
.input,
.picker,
.textarea,
.muted,
.space {
  box-sizing: border-box;
}

.notice {
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
  font-size: 25rpx;
  background: #edf5fb;
  color: #416478;
}

.label {
  font-size: 25rpx;
  font-weight: 600;
  display: block;
  margin: 22rpx 0 10rpx;
}

.input,
.picker,
.textarea {
  background: #f6f9fa;
  border: 1rpx solid #dfe8ec;
  border-radius: 16rpx;
  padding: 19rpx 22rpx;
  width: 100%;
  font-size: 27rpx;
  min-height: 82rpx;
}

.textarea {
  height: 156rpx;
}

.muted {
  color: #718491;
  font-size: 25rpx;
}

.space {
  margin-top: 24rpx;
}
