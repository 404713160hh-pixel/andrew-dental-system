.profile-form{color:#111827;font-family:"PingFang SC","HarmonyOS Sans SC",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx;line-height:1.6}.profile-form,.notice,.label,.input,.picker,.textarea,.muted,.space{box-sizing:border-box}.notice{border-radius:12rpx;padding:24rpx;margin-bottom:24rpx;font-size:25rpx;line-height:1.8;background:#eff6ff;color:#1d4ed8}.label{font-size:25rpx;font-weight:600;display:block;margin:24rpx 0 8rpx}.input,.picker,.textarea{background:#fff;border:1rpx solid #e5eaf2;border-radius:12rpx;padding:16rpx 24rpx;width:100%;font-size:27rpx;min-height:88rpx;color:#111827}.input:focus,.textarea:focus{border-color:#2563eb}.textarea{height:160rpx}.muted{color:#64748b;font-size:25rpx;line-height:1.8}.space{margin-top:24rpx}.input[disabled],.textarea[disabled],picker[disabled] .picker{background:#f8fafc;color:#64748b;border-color:#cbd5e1}
