 .profile-form{color:#252522;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6}.profile-form,.notice,.label,.input,.picker,.textarea,.muted,.space{box-sizing:border-box}.notice{border-radius:8rpx;padding:22rpx 24rpx;margin-bottom:24rpx;font-size:25rpx;background:#fcfbf9;color:#625d55}.label{font-size:25rpx;font-weight:600;display:block;margin:22rpx 0 10rpx}.input,.picker,.textarea{background:#fff;border:1rpx solid #dedbd4;border-radius:8rpx;padding:19rpx 22rpx;width:100%;font-size:27rpx;min-height:82rpx}.textarea{height:156rpx}.muted{color:#77746f;font-size:25rpx}.space{margin-top:24rpx}
