{
  "name": "@andrew/booking-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/booking-api/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "admin:create": "tsx src/cli.ts create-admin"
  },
  "dependencies": {
    "@andrew/shared": "1.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0"
  }
}
